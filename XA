/*
    Plan Regression Tracker - LITE - WINDOW 2: DETECT + ALERT (PRINT only)
    -------------------------------------------------------------------------------------------
    Run in the SAME monitored database as Window 1, in another window, whenever you want
    (e.g. every few minutes). Reads the ## tables filled by Window 1; reads Query Store only for
    the statement text and the two plans of a new alert. Nothing is written to the database.

    Output:
      1. Messages tab: one PRINTed alert per NEW regression, and one line per RESOLVED one.
      2. Result 1: every statement that ran in the current window, with the verdict (why it is / is not an alert).
      3. Result 2: all events so far (##prt_Event).
*/
SET NOCOUNT ON;
SET LOCK_TIMEOUT 3000;
SET DEADLOCK_PRIORITY LOW;

/* ======================= settings (production defaults) ======================= */
DECLARE @CurrentWindowMin     int   = 120,      -- "now" window (minutes)          local test: 15
        @BaselineHours        int   = 168,      -- baseline = this many hours before the current window   local test: 24
        @MinBaseExecs         bigint= 50,       --                                  local test: 5
        @MinCurExecs          bigint= 20,       --                                  local test: 5
        @NewPlanMinShare      float = 0.5,      -- new plan runs >= 50% of current executions
        @NewPlanMaxBaseShare  float = 0.1,      -- ...and <= 10% of baseline executions
        @ReadsRatio           float = 3,        -- reads/exec x3
        @CpuRatio             float = 2,        -- CPU/exec x2 ...
        @CpuMinDeltaMs        float = 50,       -- ... and +50 ms                   local test: 1
        @WaitRatio            float = 3,        -- a wait category x3 ...
        @WaitMinMs            float = 10,       -- ... and >= 10 ms/exec
        @AbortDelta           float = 0.05,     -- timeouts/aborts share +5 points
        @MinExtraCpuSecH      float = 30,       -- impact gates (any one)           local test: 0
        @MinExtraWaitSecH     float = 60,       --                                  local test: 0
        @MinExtraReadsH       float = 10000000, --                                  local test: 0
        @ResolveRatio         float = 1.2,      -- resolved when within 1.2x of the frozen baseline ...
        @ResolveMin           int   = 1440;     -- ... for this many minutes (or no executions)   local test: 30
/* ============================================================================== */

IF OBJECT_ID(N'tempdb..##prt_Interval') IS NULL OR OBJECT_ID(N'tempdb..##prt_State') IS NULL
BEGIN
    RAISERROR(N'Start Window 1 first (it creates the ##prt_ tables), and keep it open.', 16, 1);
    RETURN;
END;
IF (SELECT DatabaseName FROM ##prt_State) <> DB_NAME()
BEGIN
    RAISERROR(N'Run this in the same database as Window 1.', 16, 1);
    RETURN;
END;

DECLARE @Now datetime2(0) = (SELECT LastIntervalEndUtc FROM ##prt_State);     -- data time, not clock time
IF @Now IS NULL BEGIN PRINT 'Window 1 has not loaded any interval yet.'; RETURN; END;

DECLARE @CurStart  datetime2(0) = DATEADD(minute, -@CurrentWindowMin, @Now);
DECLARE @BaseStart datetime2(0) = DATEADD(hour, -@BaselineHours, @CurStart);
DECLARE @CurH      float        = @CurrentWindowMin / 60.0;

PRINT CONCAT('Detection at ', CONVERT(varchar(19), SYSDATETIME(), 120), ' | data up to ', CONVERT(varchar(19), @Now, 120),
             ' UTC | current window from ', CONVERT(varchar(19), @CurStart, 120), ' | baseline from ', CONVERT(varchar(19), @BaseStart, 120));

/* ---- aggregates: per statement, window (B/C) and plan ---- */
DROP TABLE IF EXISTS #A;
SELECT i.QueryId, CASE WHEN i.StartUtc >= @CurStart THEN 'C' ELSE 'B' END AS Win, i.PlanHash,
       MAX(i.PlanId) AS LastPlanId, MIN(i.StartUtc) AS FirstUtc,
       SUM(i.Execs) AS Execs, SUM(CASE WHEN i.ExecutionType = 3 THEN i.Execs ELSE 0 END) AS Aborted,
       SUM(i.CpuUs) AS Cpu, SUM(i.DurUs) AS Dur, SUM(i.Reads) AS Reads
INTO #A
FROM ##prt_Interval AS i
WHERE i.StartUtc >= @BaseStart AND i.StartUtc < @Now
  AND i.QueryId IN (SELECT QueryId FROM ##prt_Interval WHERE StartUtc >= @CurStart AND StartUtc < @Now)
GROUP BY i.QueryId, CASE WHEN i.StartUtc >= @CurStart THEN 'C' ELSE 'B' END, i.PlanHash;

DROP TABLE IF EXISTS #W;
SELECT w.QueryId, CASE WHEN k.StartUtc >= @CurStart THEN 'C' ELSE 'B' END AS Win, k.PlanHash, w.WaitCategory, SUM(w.WaitMs) AS WaitMs
INTO #W
FROM ##prt_Wait AS w
JOIN (SELECT DISTINCT QueryId, IntervalId, PlanId, PlanHash, StartUtc FROM ##prt_Interval) AS k
  ON k.QueryId = w.QueryId AND k.IntervalId = w.IntervalId AND k.PlanId = w.PlanId
WHERE k.StartUtc >= @BaseStart AND k.StartUtc < @Now
  AND w.WaitCategory NOT IN (N'Idle', N'User Wait')
  AND w.QueryId IN (SELECT QueryId FROM #A)
GROUP BY w.QueryId, CASE WHEN k.StartUtc >= @CurStart THEN 'C' ELSE 'B' END, k.PlanHash, w.WaitCategory;

/* ---- per statement totals + dominant current plan ---- */
DROP TABLE IF EXISTS #T;
SELECT QueryId,
       SUM(CASE WHEN Win = 'B' THEN Execs   ELSE 0 END) AS BaseExecs,
       SUM(CASE WHEN Win = 'B' THEN Aborted ELSE 0 END) AS BaseAborted,
       SUM(CASE WHEN Win = 'B' THEN Cpu     ELSE 0 END) AS BaseCpu,
       SUM(CASE WHEN Win = 'B' THEN Dur     ELSE 0 END) AS BaseDur,
       SUM(CASE WHEN Win = 'B' THEN Reads   ELSE 0 END) AS BaseReads,
       SUM(CASE WHEN Win = 'C' THEN Execs   ELSE 0 END) AS CurExecs,
       SUM(CASE WHEN Win = 'C' THEN Cpu     ELSE 0 END) AS CurCpu,
       SUM(CASE WHEN Win = 'C' THEN Reads   ELSE 0 END) AS CurReads,
       CAST(NULL AS binary(8)) AS TopHash, CAST(NULL AS bigint) AS TopPlanId, CAST(NULL AS datetime2(0)) AS TopFirstUtc,
       CAST(NULL AS bigint) AS TopExecs, CAST(NULL AS bigint) AS TopAborted,
       CAST(NULL AS float) AS TopCpu, CAST(NULL AS float) AS TopDur, CAST(NULL AS float) AS TopReads,
       CAST(NULL AS bigint) AS TopBaseExecs, CAST(NULL AS binary(8)) AS BaseHash, CAST(NULL AS bigint) AS BasePlanId
INTO #T
FROM #A
GROUP BY QueryId;

UPDATE t
SET TopHash = x.PlanHash, TopPlanId = x.LastPlanId, TopExecs = x.Execs, TopAborted = x.Aborted,
    TopCpu = x.Cpu, TopDur = x.Dur, TopReads = x.Reads
FROM #T AS t
CROSS APPLY (SELECT TOP (1) a.* FROM #A AS a WHERE a.QueryId = t.QueryId AND a.Win = 'C' ORDER BY a.Execs DESC, a.Cpu DESC) AS x;

UPDATE t
SET TopBaseExecs = ISNULL((SELECT a.Execs FROM #A AS a WHERE a.QueryId = t.QueryId AND a.Win = 'B' AND a.PlanHash = t.TopHash), 0),
    TopFirstUtc  = (SELECT MIN(a.FirstUtc) FROM #A AS a WHERE a.QueryId = t.QueryId AND a.PlanHash = t.TopHash),
    BaseHash     = b.PlanHash,
    BasePlanId   = b.LastPlanId
FROM #T AS t
OUTER APPLY (SELECT TOP (1) a.PlanHash, a.LastPlanId FROM #A AS a WHERE a.QueryId = t.QueryId AND a.Win = 'B' ORDER BY a.Execs DESC) AS b;

/* ---- per statement metrics + flags ---- */
DROP TABLE IF EXISTS #R;
SELECT t.QueryId, t.TopHash, t.TopPlanId, t.TopFirstUtc, t.BaseHash, t.BasePlanId, t.BaseExecs, t.CurExecs, t.TopExecs, t.TopAborted,
       CAST(t.TopExecs AS float) / NULLIF(t.CurExecs, 0)     AS TopShare,
       CAST(t.TopBaseExecs AS float) / NULLIF(t.BaseExecs, 0) AS TopBaseShare,
       t.BaseCpu / NULLIF(t.BaseExecs, 0) AS bCpu,   t.TopCpu / NULLIF(t.TopExecs, 0) AS cCpu,
       t.BaseDur / NULLIF(t.BaseExecs, 0) AS bDur,   t.TopDur / NULLIF(t.TopExecs, 0) AS cDur,
       t.BaseReads / NULLIF(t.BaseExecs, 0) AS bReads, t.TopReads / NULLIF(t.TopExecs, 0) AS cReads,
       CAST(t.BaseAborted AS float) / NULLIF(t.BaseExecs, 0) AS bAb,
       CAST(t.TopAborted AS float) / NULLIF(t.TopExecs, 0)   AS cAb,
       CAST(t.TopExecs AS float) / @CurH AS ExecPerHour,
       CAST(0 AS bit) AS ReadsUp, CAST(0 AS bit) AS CpuUp, CAST(0 AS bit) AS AbortUp, CAST(0 AS bit) AS WaitUp,
       CAST(0 AS float) AS ExtraCpuSecH, CAST(0 AS float) AS ExtraReadsH, CAST(0 AS float) AS ExtraWaitSecH,
       CAST(NULL AS nvarchar(1000)) AS WaitDetail, CAST(NULL AS nvarchar(200)) AS Verdict
INTO #R
FROM #T AS t;

UPDATE #R
SET ReadsUp = CASE WHEN cReads > bReads AND cReads >= @ReadsRatio * bReads THEN 1 ELSE 0 END,
    CpuUp   = CASE WHEN cCpu >= @CpuRatio * bCpu AND cCpu - bCpu >= @CpuMinDeltaMs * 1000.0 THEN 1 ELSE 0 END,
    AbortUp = CASE WHEN cAb - bAb >= @AbortDelta AND TopAborted >= 3 THEN 1 ELSE 0 END,
    ExtraCpuSecH = ISNULL((cCpu - bCpu) * ExecPerHour / 1000000.0, 0),
    ExtraReadsH  = ISNULL((cReads - bReads) * ExecPerHour, 0);

DROP TABLE IF EXISTS #WC;
SELECT x.QueryId, x.WaitCategory, x.BaseMs, x.CurMs,
       CASE WHEN x.CurMs >= @WaitMinMs AND x.CurMs >= @WaitRatio * x.BaseMs
                 AND (x.CurMs - x.BaseMs) * r.ExecPerHour / 1000.0 >= @MinExtraWaitSecH THEN 1 ELSE 0 END AS Up,
       (x.CurMs - x.BaseMs) * r.ExecPerHour / 1000.0 AS ExtraSecH
INTO #WC
FROM (
    SELECT w.QueryId, w.WaitCategory,
           ISNULL(SUM(CASE WHEN w.Win = 'B' THEN w.WaitMs END), 0) / NULLIF(MAX(r.BaseExecs), 0) AS BaseMs,
           ISNULL(SUM(CASE WHEN w.Win = 'C' AND w.PlanHash = r.TopHash THEN w.WaitMs END), 0) / NULLIF(MAX(r.TopExecs), 0) AS CurMs
    FROM #W AS w JOIN #R AS r ON r.QueryId = w.QueryId
    GROUP BY w.QueryId, w.WaitCategory
) AS x
JOIN #R AS r ON r.QueryId = x.QueryId;

UPDATE r
SET WaitUp = CASE WHEN EXISTS (SELECT 1 FROM #WC AS c WHERE c.QueryId = r.QueryId AND c.Up = 1) THEN 1 ELSE 0 END,
    ExtraWaitSecH = ISNULL((SELECT SUM(c.ExtraSecH) FROM #WC AS c WHERE c.QueryId = r.QueryId AND c.Up = 1), 0),
    WaitDetail = STUFF((SELECT N'; ' + c.WaitCategory + N' ' + FORMAT(c.CurMs, 'N1') + N' ms/exec (was ' + FORMAT(c.BaseMs, 'N1') + N')'
                               + CASE WHEN c.Up = 1 THEN N' UP' ELSE N'' END
                        FROM #WC AS c
                        WHERE c.QueryId = r.QueryId AND (c.CurMs >= 1 OR c.BaseMs >= 1)
                        ORDER BY c.Up DESC, c.CurMs DESC
                        FOR XML PATH(''), TYPE).value('.', 'nvarchar(max)'), 1, 2, N'')
FROM #R AS r;

UPDATE #R
SET Verdict = CASE
    WHEN BaseExecs < @MinBaseExecs THEN CONCAT('no: baseline has ', BaseExecs, ' execs (need ', @MinBaseExecs, ')')
    WHEN ISNULL(TopExecs, 0) < @MinCurExecs THEN CONCAT('no: dominant plan has ', ISNULL(TopExecs, 0), ' current execs (need ', @MinCurExecs, ')')
    WHEN TopShare < @NewPlanMinShare THEN CONCAT('no: dominant plan runs only ', FORMAT(TopShare * 100, 'N0'), '% of current execs')
    WHEN ISNULL(TopBaseShare, 0) > @NewPlanMaxBaseShare THEN CONCAT('no: same plan as baseline (', FORMAT(TopBaseShare * 100, 'N0'), '% of baseline execs)')
    WHEN ReadsUp = 0 AND CpuUp = 0 AND WaitUp = 0 AND AbortUp = 0 THEN 'no: new plan, but cost per exec not up enough'
    WHEN NOT (ExtraCpuSecH >= @MinExtraCpuSecH OR ExtraWaitSecH >= @MinExtraWaitSecH OR ExtraReadsH >= @MinExtraReadsH OR AbortUp = 1)
         THEN CONCAT('no: new plan + costlier, but impact small (', FORMAT(ExtraCpuSecH, 'N1'), ' CPU s/h, ', FORMAT(ExtraReadsH, 'N0'), ' reads/h)')
    ELSE 'ALERT' END;

/* ---- events ---- */

-- open events still bad compared with their FROZEN baseline?
UPDATE e
SET LastBadUtc = @Now
FROM ##prt_Event AS e
JOIN #T AS t ON t.QueryId = e.QueryId
WHERE e.Status = 'Open' AND t.CurExecs > 0
  AND (    t.CurReads / NULLIF(t.CurExecs, 0) > @ResolveRatio * ISNULL(e.BaseReads, 0)
       OR (t.CurCpu / NULLIF(t.CurExecs, 0) / 1000.0 > @ResolveRatio * ISNULL(e.BaseCpuMs, 0)
           AND t.CurCpu / NULLIF(t.CurExecs, 0) / 1000.0 - ISNULL(e.BaseCpuMs, 0) >= @CpuMinDeltaMs));

-- already open: refresh current numbers (baseline stays frozen)
UPDATE e
SET LastBadUtc = @Now, NewPlanHash = r.TopHash, NewPlanId = r.TopPlanId, NewPlanSharePct = r.TopShare * 100,
    CurExecs = r.TopExecs, CurCpuMs = r.cCpu / 1000.0, CurDurMs = r.cDur / 1000.0, CurReads = r.cReads,
    ExtraCpuSecH = r.ExtraCpuSecH, ExtraWaitSecH = r.ExtraWaitSecH, ExtraReadsH = r.ExtraReadsH, WaitDetail = r.WaitDetail
FROM ##prt_Event AS e
JOIN #R AS r ON r.QueryId = e.QueryId
WHERE e.Status = 'Open' AND r.Verdict = 'ALERT';

-- new events
INSERT ##prt_Event (QueryId, ObjectId, ModuleName, Status, FirstUtc, LastBadUtc, BasePlanHash, NewPlanHash, BasePlanId, NewPlanId,
                    NewPlanSharePct, BaseExecs, CurExecs, BaseCpuMs, CurCpuMs, BaseDurMs, CurDurMs, BaseReads, CurReads,
                    ExtraCpuSecH, ExtraWaitSecH, ExtraReadsH, Signals, WaitDetail)
SELECT r.QueryId, o.ObjectId, OBJECT_SCHEMA_NAME(o.ObjectId) + N'.' + OBJECT_NAME(o.ObjectId), 'Open', @Now, @Now,
       r.BaseHash, r.TopHash, r.BasePlanId, r.TopPlanId,
       r.TopShare * 100, r.BaseExecs, r.TopExecs, r.bCpu / 1000.0, r.cCpu / 1000.0, r.bDur / 1000.0, r.cDur / 1000.0, r.bReads, r.cReads,
       r.ExtraCpuSecH, r.ExtraWaitSecH, r.ExtraReadsH,
       LEFT(CONCAT('new plan runs ', FORMAT(r.TopShare * 100, 'N0'), '% of executions',
                   CASE WHEN r.ReadsUp = 1 THEN '; reads/exec x' + FORMAT(r.cReads / NULLIF(r.bReads, 0), 'N1') END,
                   CASE WHEN r.CpuUp   = 1 THEN '; CPU/exec x'   + FORMAT(r.cCpu / NULLIF(r.bCpu, 0), 'N1') END,
                   CASE WHEN r.WaitUp  = 1 THEN '; waits up' END,
                   CASE WHEN r.AbortUp = 1 THEN '; timeouts/aborts ' + FORMAT(r.cAb * 100, 'N1') + '%' END), 400),
       r.WaitDetail
FROM #R AS r
CROSS APPLY (SELECT MAX(ObjectId) AS ObjectId FROM ##prt_Interval AS i WHERE i.QueryId = r.QueryId) AS o
WHERE r.Verdict = 'ALERT'
  AND NOT EXISTS (SELECT 1 FROM ##prt_Event AS e WHERE e.QueryId = r.QueryId AND e.Status = 'Open');

-- resolve
UPDATE ##prt_Event
SET Status = 'Resolved', ResolvedUtc = @Now
WHERE Status = 'Open' AND LastBadUtc <= DATEADD(minute, -@ResolveMin, @Now);

/* ---- print new alerts ---- */
DECLARE @id int, @q bigint, @obj int, @bp bigint, @np bigint, @line nvarchar(4000), @txt nvarchar(400),
        @hints nvarchar(2000), @newFirst datetime2(0), @modUtc datetime2(0), @compile datetimeoffset,
        @bForced bit, @bFail bigint, @bReason nvarchar(128),
        @w char(1), @pid bigint, @ptxt nvarchar(max), @x xml;
DROP TABLE IF EXISTS #pf;
CREATE TABLE #pf (Which char(1) NOT NULL PRIMARY KEY, PlanId bigint NULL, Params nvarchar(2000) NULL, EstRows float NULL,
                  IsParallel bit NULL, DesiredMemKB bigint NULL, Loaded bit NOT NULL DEFAULT (0));

SET @id = (SELECT MIN(EventId) FROM ##prt_Event WHERE Printed = 0);
WHILE @id IS NOT NULL
BEGIN
    SELECT @q = QueryId, @obj = ObjectId, @bp = BasePlanId, @np = NewPlanId FROM ##prt_Event WHERE EventId = @id;

    SET @txt = (SELECT TOP (1) LEFT(REPLACE(REPLACE(t.query_sql_text, NCHAR(13), N' '), NCHAR(10), N' '), 400)
                FROM sys.query_store_query AS q JOIN sys.query_store_query_text AS t ON t.query_text_id = q.query_text_id
                WHERE q.query_id = @q);

    /* plan facts for the baseline plan (B) and the new plan (N) */
    DELETE #pf;
    INSERT #pf (Which, PlanId) VALUES ('B', @bp), ('N', @np);
    SET @w = 'B';
    SELECT @txt = NULL, @hints = N'', @bForced = NULL, @bFail = NULL, @bReason = NULL, @newFirst = NULL, @compile = NULL, @modUtc = NULL;
    WHILE @w IS NOT NULL
    BEGIN
        SELECT @pid = PlanId FROM #pf WHERE Which = @w;
        SET @x = NULL; SET @ptxt = NULL;
        BEGIN TRY
            SELECT @ptxt = query_plan FROM sys.query_store_plan WHERE plan_id = @pid;
            SET @x = TRY_CONVERT(xml, @ptxt);
            IF @x IS NOT NULL
            BEGIN
            ;WITH XMLNAMESPACES (DEFAULT 'http://schemas.microsoft.com/sqlserver/2004/07/showplan')
            UPDATE #pf
            SET Params = LEFT(@x.query('for $c in //QueryPlan/ParameterList/ColumnReference
                                        return concat(string($c/@Column), "=", string($c/@ParameterCompiledValue), ";")').value('.', 'nvarchar(max)'), 2000),
                EstRows = @x.value('(//StmtSimple/@StatementEstRows)[1]', 'float'),
                IsParallel = @x.exist('//RelOp[@Parallel="1" or @Parallel="true"]'),
                DesiredMemKB = @x.value('(//MemoryGrantInfo/@SerialDesiredMemory)[1]', 'bigint'),
                Loaded = 1
            WHERE Which = @w;
            END;
        END TRY
        BEGIN CATCH
            -- very deep plans cannot be converted to xml; skip the facts
        END CATCH;
        SET @w = CASE WHEN @w = 'B' THEN 'N' END;
    END;

    SET @hints = N'';
    SELECT @bForced = CAST(is_forced_plan AS bit), @bFail = force_failure_count, @bReason = last_force_failure_reason_desc
    FROM sys.query_store_plan WHERE plan_id = @bp;
    IF @bForced = 1
        SET @hints += N'Baseline plan is FORCED' + CASE WHEN @bFail > 0 THEN N' but forcing fails (' + ISNULL(@bReason, N'?') + N')' ELSE N'' END + N'. ';
    SELECT @hints += CASE WHEN b.IsParallel <> n.IsParallel THEN CASE WHEN n.IsParallel = 1 THEN N'Plan went parallel. ' ELSE N'Plan went serial. ' END ELSE N'' END
                   + CASE WHEN ISNULL(b.Params, N'') <> ISNULL(n.Params, N'') AND b.Loaded = 1 AND n.Loaded = 1
                          THEN N'Compiled for different parameter values (parameter sniffing?): before [' + ISNULL(b.Params, N'') + N'] now [' + ISNULL(n.Params, N'') + N']. ' ELSE N'' END
                   + CASE WHEN b.EstRows > 0 AND n.EstRows > 0 AND (n.EstRows / b.EstRows >= 10 OR b.EstRows / n.EstRows >= 10)
                          THEN N'Estimated rows ' + FORMAT(b.EstRows, 'N0') + N' -> ' + FORMAT(n.EstRows, 'N0') + N' (statistics / estimate). ' ELSE N'' END
                   + CASE WHEN b.DesiredMemKB > 0 AND n.DesiredMemKB > 0 AND (n.DesiredMemKB * 1.0 / b.DesiredMemKB >= 4 OR b.DesiredMemKB * 1.0 / n.DesiredMemKB >= 4)
                          THEN N'Memory grant ' + FORMAT(b.DesiredMemKB, 'N0') + N' KB -> ' + FORMAT(n.DesiredMemKB, 'N0') + N' KB. ' ELSE N'' END
    FROM #pf AS b CROSS JOIN #pf AS n WHERE b.Which = 'B' AND n.Which = 'N';

    SELECT @newFirst = MIN(StartUtc) FROM ##prt_Interval WHERE QueryId = @q AND PlanId = @np;
    SELECT @compile = last_compile_start_time FROM sys.query_store_plan WHERE plan_id = @np;
    SELECT @modUtc = DATEADD(minute, DATEDIFF(minute, SYSDATETIME(), SYSUTCDATETIME()), modify_date) FROM sys.objects WHERE object_id = @obj;
    IF @modUtc BETWEEN DATEADD(hour, -6, @newFirst) AND DATEADD(hour, 1, @newFirst)
        SET @hints += N'Module was modified at ' + CONVERT(nvarchar(19), @modUtc, 120) + N' UTC, close to when the new plan appeared. ';
    SET @hints += N'New plan first seen ' + ISNULL(CONVERT(nvarchar(19), @newFirst, 120), N'?') + N' UTC, compiled '
                + ISNULL(CONVERT(nvarchar(19), SWITCHOFFSET(@compile, '+00:00'), 120), N'?') + N' UTC.';

    PRINT N'';
    PRINT N'==================== PLAN REGRESSION (event ' + CAST(@id AS nvarchar(10)) + N') ====================';
    SELECT @line = N'Module        : ' + ISNULL(ModuleName, CONCAT(N'object ', ObjectId)) + N'   (query_id ' + CAST(QueryId AS nvarchar(20)) + N', db ' + DB_NAME() + N')' FROM ##prt_Event WHERE EventId = @id; PRINT @line;
    SELECT @line = N'What changed  : ' + Signals FROM ##prt_Event WHERE EventId = @id; PRINT @line;
    SELECT @line = N'Plans         : ' + ISNULL(CONVERT(nvarchar(20), BasePlanHash, 1), N'?') + N' (plan_id ' + ISNULL(CAST(BasePlanId AS nvarchar(20)), N'?') + N')  ->  '
                 + CONVERT(nvarchar(20), NewPlanHash, 1) + N' (plan_id ' + ISNULL(CAST(NewPlanId AS nvarchar(20)), N'?') + N')' FROM ##prt_Event WHERE EventId = @id; PRINT @line;
    SELECT @line = N'Executions    : ' + FORMAT(BaseExecs, 'N0') + N' in baseline  ->  ' + FORMAT(CurExecs, 'N0') + N' on new plan in current window' FROM ##prt_Event WHERE EventId = @id; PRINT @line;
    SELECT @line = N'CPU ms/exec   : ' + FORMAT(BaseCpuMs, 'N2') + N'  ->  ' + FORMAT(CurCpuMs, 'N2') FROM ##prt_Event WHERE EventId = @id; PRINT @line;
    SELECT @line = N'Duration ms   : ' + FORMAT(BaseDurMs, 'N2') + N'  ->  ' + FORMAT(CurDurMs, 'N2') FROM ##prt_Event WHERE EventId = @id; PRINT @line;
    SELECT @line = N'Reads/exec    : ' + FORMAT(BaseReads, 'N0') + N'  ->  ' + FORMAT(CurReads, 'N0') FROM ##prt_Event WHERE EventId = @id; PRINT @line;
    SELECT @line = N'Waits/exec    : ' + ISNULL(WaitDetail, N'-') FROM ##prt_Event WHERE EventId = @id; PRINT @line;
    SELECT @line = N'Extra cost    : ' + FORMAT(ExtraCpuSecH, 'N1') + N' CPU s/hour, ' + FORMAT(ExtraWaitSecH, 'N1') + N' wait s/hour, '
                 + FORMAT(ExtraReadsH, 'N0') + N' reads/hour' FROM ##prt_Event WHERE EventId = @id; PRINT @line;
    PRINT N'Likely cause  : ' + @hints;
    PRINT N'Statement     : ' + ISNULL(@txt, N'(text not available)');
    IF @bp IS NOT NULL
    BEGIN
        PRINT N'Fix (REVIEW, run on the PRIMARY):';
        PRINT N'    EXEC sys.sp_query_store_force_plan @query_id = ' + CAST(@q AS nvarchar(20)) + N', @plan_id = ' + CAST(@bp AS nvarchar(20)) + N';';
        PRINT N'    -- undo: EXEC sys.sp_query_store_unforce_plan @query_id = ' + CAST(@q AS nvarchar(20)) + N', @plan_id = ' + CAST(@bp AS nvarchar(20)) + N';';
    END;

    UPDATE ##prt_Event SET Printed = 1 WHERE EventId = @id;
    SET @id = (SELECT MIN(EventId) FROM ##prt_Event WHERE Printed = 0 AND EventId > @id);
END;

/* ---- print resolved ---- */
SET @id = (SELECT MIN(EventId) FROM ##prt_Event WHERE Status = 'Resolved' AND ResolvedPrinted = 0);
WHILE @id IS NOT NULL
BEGIN
    SELECT @line = N'RESOLVED event ' + CAST(EventId AS nvarchar(10)) + N': ' + ISNULL(ModuleName, N'?') + N' (query_id ' + CAST(QueryId AS nvarchar(20))
                 + N') back within ' + FORMAT(@ResolveRatio, 'N1') + N'x of its baseline (or not running) for ' + CAST(@ResolveMin AS nvarchar(10)) + N' min.'
    FROM ##prt_Event WHERE EventId = @id;
    PRINT @line;
    UPDATE ##prt_Event SET ResolvedPrinted = 1 WHERE EventId = @id;
    SET @id = (SELECT MIN(EventId) FROM ##prt_Event WHERE Status = 'Resolved' AND ResolvedPrinted = 0 AND EventId > @id);
END;

IF NOT EXISTS (SELECT 1 FROM #R WHERE Verdict = 'ALERT')
    PRINT N'No new plan regression in this run. See the Verdict column for why each statement is not an alert.';

/* ---- result 1: what detection saw ---- */
SELECT r.Verdict,
       OBJECT_SCHEMA_NAME(o.ObjectId) + N'.' + OBJECT_NAME(o.ObjectId) AS ModuleName,
       r.QueryId, r.BaseExecs, r.CurExecs, r.TopExecs AS NewPlanExecs,
       CAST(r.TopShare * 100 AS decimal(6,1))     AS NewPlanPctNow,
       CAST(r.TopBaseShare * 100 AS decimal(6,1)) AS NewPlanPctInBaseline,
       CAST(r.bCpu / 1000.0 AS decimal(18,2)) AS BaseCpuMs, CAST(r.cCpu / 1000.0 AS decimal(18,2)) AS NowCpuMs,
       CAST(r.bReads AS decimal(19,0)) AS BaseReads, CAST(r.cReads AS decimal(19,0)) AS NowReads,
       r.ReadsUp, r.CpuUp, r.WaitUp, r.AbortUp,
       CAST(r.ExtraCpuSecH AS decimal(18,1)) AS ExtraCpuSecH, CAST(r.ExtraReadsH AS decimal(19,0)) AS ExtraReadsH,
       CAST(r.ExtraWaitSecH AS decimal(18,1)) AS ExtraWaitSecH, r.WaitDetail,
       CONVERT(varchar(20), r.BaseHash, 1) AS BasePlanHash, r.BasePlanId,
       CONVERT(varchar(20), r.TopHash, 1) AS NowPlanHash, r.TopPlanId AS NowPlanId
FROM #R AS r
CROSS APPLY (SELECT MAX(ObjectId) AS ObjectId FROM ##prt_Interval AS i WHERE i.QueryId = r.QueryId) AS o
ORDER BY CASE WHEN r.Verdict = 'ALERT' THEN 0 ELSE 1 END, r.ExtraCpuSecH DESC;

/* ---- result 2: all events ---- */
SELECT EventId, Status, ModuleName, QueryId, Signals, FirstUtc, LastBadUtc, ResolvedUtc,
       CAST(BaseCpuMs AS decimal(18,2)) AS BaseCpuMs, CAST(CurCpuMs AS decimal(18,2)) AS CurCpuMs,
       CAST(BaseReads AS decimal(19,0)) AS BaseReads, CAST(CurReads AS decimal(19,0)) AS CurReads,
       CAST(ExtraCpuSecH AS decimal(18,1)) AS ExtraCpuSecH, BasePlanId, NewPlanId, WaitDetail
FROM ##prt_Event
ORDER BY EventId DESC;
