function Set-Status { param([string]$Text) $lblStatus.Text = $Text }

# Distinct, colorblind-tolerant palette (borrowed from the common
# "Tableau 10 / Vega category10"-style set) so each bar reads as its own
# query at a glance, the same way Query Store colors each query in its
# charts. Cycles if there are more rows than colors.
$script:ChartPalette = @(
    '#4C78A8','#F58518','#54A24B','#E45756','#72B7B2','#EECA3B',
    '#B279A2','#FF9DA6','#9D755D','#BAB0AC','#5254A3','#8CA252'
)

# Redraws the Chart tab from whatever the last search returned. Works for
# BOTH backends: Query Store rows carry query_id + count_executions,
# plan-cache rows carry query_hash_hex + execution_count instead -- this
# looks at whichever columns are actually present rather than assuming one
# shape, so the exact same function serves both of the "two paths" this
# tool was built around.
function Update-Chart {
    param([System.Data.DataTable]$Table, [string]$Metric = 'Avg Duration (ms)')

    if (-not $script:ChartAvailable -or -not $chart) { return }
    $chart.Series.Clear()
    $chart.Titles.Clear()
    if (-not $Table -or $Table.Rows.Count -eq 0) { return }

    $execCountCol = if ($Table.Columns.Contains('count_executions')) { 'count_executions' } else { 'execution_count' }
    $metricCol = switch ($Metric) {
        'Executions'        { $execCountCol }
        'Avg CPU (ms)'      { 'avg_cpu_ms' }
        'Avg Logical Reads' { 'avg_logical_reads' }
        default             { 'avg_duration_ms' }
    }
    if (-not $Table.Columns.Contains($metricCol)) { return }

    $sortedRows = @($Table.Select('', "$metricCol DESC") | Select-Object -First 25)
    if ($sortedRows.Count -eq 0) { return }

    $series = New-Object System.Windows.Forms.DataVisualization.Charting.Series
    $series.ChartType = [System.Windows.Forms.DataVisualization.Charting.SeriesChartType]::Column
    [void]$chart.Series.Add($series)
    $chart.ChartAreas[0].AxisY.Title = $Metric

    for ($i = 0; $i -lt $sortedRows.Count; $i++) {
        $row = $sortedRows[$i]

        $label =
            if ($Table.Columns.Contains('proc_name') -and -not $row.IsNull('proc_name') -and $row['proc_name']) { [string]$row['proc_name'] }
            elseif ($Table.Columns.Contains('query_id')) { "Query $($row['query_id'])" }
            elseif ($Table.Columns.Contains('query_hash_hex') -and -not $row.IsNull('query_hash_hex') -and $row['query_hash_hex']) { [string]$row['query_hash_hex'] }
            else { "Row $($i + 1)" }

        $value = if ($row.IsNull($metricCol)) { 0 } else { [double]$row[$metricCol] }
        $pointIndex = $series.Points.AddXY($label, $value)
        $point = $series.Points[$pointIndex]
        $point.Color = [System.Drawing.ColorTranslator]::FromHtml($script:ChartPalette[$i % $script:ChartPalette.Count])

        $execCount = if ($Table.Columns.Contains($execCountCol) -and -not $row.IsNull($execCountCol)) { $row[$execCountCol] } else { 'n/a' }
        $durMs     = if ($Table.Columns.Contains('avg_duration_ms') -and -not $row.IsNull('avg_duration_ms')) { $row['avg_duration_ms'] } else { 'n/a' }
        $cpuMs     = if ($Table.Columns.Contains('avg_cpu_ms') -and -not $row.IsNull('avg_cpu_ms')) { $row['avg_cpu_ms'] } else { 'n/a' }
        $point.ToolTip = "$label`nExecutions: $execCount`nAvg Duration: $durMs ms`nAvg CPU: $cpuMs ms"
    }

    [void]$chart.Titles.Add("Top $($sortedRows.Count) by $Metric")
}

# Redraws the Timeline tab: one scatter series per plan_id, X = interval end
# time, Y = the selected metric -- this is what reproduces the screenshot
# of Query Store's own "Tracked Queries" chart (dots over a time axis,
# colored/legended by Plan Id). Only ever called with Query Store data;
# there's no plan-cache equivalent (see the SqlQueryStoreTimeline comment).
function Update-Timeline {
    param([System.Data.DataTable]$Table, [string]$Metric = 'Avg Duration (ms)')

    if (-not $script:ChartAvailable -or -not $chartTimeline) { return }
    $chartTimeline.Series.Clear()
    $chartTimeline.Titles.Clear()
    if (-not $Table -or $Table.Rows.Count -eq 0) { return }

    $metricCol = switch ($Metric) {
        'Executions'        { 'count_executions' }
        'Avg CPU (ms)'      { 'avg_cpu_ms' }
        'Avg Logical Reads' { 'avg_logical_reads' }
        default             { 'avg_duration_ms' }
    }
    $chartTimeline.ChartAreas[0].AxisY.Title = $Metric

    $planGroups = $Table.Rows | Group-Object { $_['plan_id'] } | Sort-Object Name
    $i = 0
    foreach ($grp in $planGroups) {
        $series = New-Object System.Windows.Forms.DataVisualization.Charting.Series "Plan $($grp.Name)"
        $series.ChartType = [System.Windows.Forms.DataVisualization.Charting.SeriesChartType]::Point
        $series.MarkerStyle = [System.Windows.Forms.DataVisualization.Charting.MarkerStyle]::Circle
        $series.MarkerSize = 8
        $series.XValueType = [System.Windows.Forms.DataVisualization.Charting.ChartValueType]::DateTime
        $series.Color = [System.Drawing.ColorTranslator]::FromHtml($script:ChartPalette[$i % $script:ChartPalette.Count])
        [void]$chartTimeline.Series.Add($series)

        foreach ($row in ($grp.Group | Sort-Object { $_['interval_end_time'] })) {
            # interval_end_time comes back from ADO.NET as a DateTimeOffset
            # (it's a SQL datetimeoffset column) -- take .LocalDateTime
            # explicitly rather than relying on an implicit cast, so the
            # X axis shows your local wall-clock time.
            $x = ([DateTimeOffset]$row['interval_end_time']).LocalDateTime
            $y = if ($row.IsNull($metricCol)) { 0 } else { [double]$row[$metricCol] }
            $pointIndex = $series.Points.AddXY($x, $y)
            $point = $series.Points[$pointIndex]
            $execCount = if (-not $row.IsNull('count_executions')) { $row['count_executions'] } else { 'n/a' }
            $procName  = if (-not $row.IsNull('proc_name')) { [string]$row['proc_name'] } else { $null }
            $label     = if ($procName) { $procName } else { "Query $($row['query_id'])" }
            $point.ToolTip = "$label (Plan $($grp.Name))`n$($x.ToString('h:mm:ss tt'))`nExecutions: $execCount`n$Metric`: $y"
        }
        $i++
    }

    [void]$chartTimeline.Titles.Add("$($planGroups.Count) plan(s) over time")
}

$btnConnect.Add_Click({
    if ([string]::IsNullOrWhiteSpace($txtServer.Text)) {
        [System.Windows.Forms.MessageBox]::Show('Server is required.', 'Missing info', 'OK', 'Warning') | Out-Null
        return
    }
    $serverName = $txtServer.Text.Trim()
    $dbName     = $txtDatabase.Text.Trim()

    $btnConnect.Enabled = $false
    $btnSearch.Enabled = $false

    # Database left blank: connect at server level just to enumerate
    # databases, populate the dropdown + on-disk cache, then stop --
    # the user picks a database and clicks Connect again to do the real
    # (per-database) connect + Query Store check below.
    if ([string]::IsNullOrWhiteSpace($dbName)) {
        $lblQsState.Text = 'Listing databases...'
        $lblQsState.ForeColor = [System.Drawing.Color]::DimGray

        $serverConnStr = New-SqlConnectionString -ServerName $serverName `
            -UseSqlAuth:$radioSqlAuth.Checked -SqlUser $txtSqlUser.Text -SqlPassword $txtSqlPassword.Text

        try {
            $dbNames = Get-ServerDatabases -ConnectionString $serverConnStr
            $currentText = $txtDatabase.Text
            $txtDatabase.Items.Clear()
            if ($dbNames -and $dbNames.Count -gt 0) { [void]$txtDatabase.Items.AddRange(@($dbNames)) }
            $txtDatabase.Text = $currentText

            if (-not $script:DatabaseCache) { $script:DatabaseCache = @{} }
            $script:DatabaseCache[$serverName] = @($dbNames)
            Export-DatabaseCache -Cache $script:DatabaseCache

            $lblQsState.Text = "Found $($dbNames.Count) database(s). Pick one above, then click Connect again."
            $lblQsState.ForeColor = [System.Drawing.Color]::SeaGreen
        }
        catch {
            [System.Windows.Forms.MessageBox]::Show("Could not list databases:`r`n$($_.Exception.Message)", 'Connection failed', 'OK', 'Error') | Out-Null
            $lblQsState.Text = 'Not connected'
            $lblQsState.ForeColor = [System.Drawing.Color]::DimGray
        }
        finally {
            $btnConnect.Enabled = $true
        }
        return
    }

    $lblQsState.Text = 'Connecting...'
    $lblQsState.ForeColor = [System.Drawing.Color]::DimGray

    $connStr = New-SqlConnectionString -ServerName $serverName -DatabaseName $dbName `
        -UseSqlAuth:$radioSqlAuth.Checked -SqlUser $txtSqlUser.Text -SqlPassword $txtSqlPassword.Text

    # Connectivity + "is Query Store on" check runs synchronously here: it is
    # a single sub-second metadata call (SELECT actual_state_desc FROM
    # sys.database_query_store_options), so a brief UI block is acceptable.
    # The potentially slower part -- the actual history query -- always runs
    # async via Invoke-Async in the Search handler below.
    try {
        $isOn = Test-QueryStoreEnabled -ConnectionString $connStr
        $script:ConnectionString = $connStr
        $script:QueryStoreOn = $isOn
        if ($isOn) {
            $lblQsState.Text = 'Query Store: ON'
            $lblQsState.ForeColor = [System.Drawing.Color]::SeaGreen
        } else {
            $lblQsState.Text = 'Query Store: OFF (using plan cache)'
            $lblQsState.ForeColor = [System.Drawing.Color]::DarkOrange
        }
        $btnSearch.Enabled = $true

        if (-not $script:DatabaseCache) { $script:DatabaseCache = @{} }
        $existing = if ($script:DatabaseCache.ContainsKey($serverName)) { @($script:DatabaseCache[$serverName]) } else { @() }
        if ($existing -notcontains $dbName) {
            $script:DatabaseCache[$serverName] = @($existing + $dbName) | Sort-Object -Unique
            Export-DatabaseCache -Cache $script:DatabaseCache
        }
    }
    catch {
        [System.Windows.Forms.MessageBox]::Show("Could not connect:`r`n$($_.Exception.Message)", 'Connection failed', 'OK', 'Error') | Out-Null
        $lblQsState.Text = 'Not connected'
        $lblQsState.ForeColor = [System.Drawing.Color]::DimGray
    }
    finally {
        $btnConnect.Enabled = $true
    }
})

$btnSearch.Add_Click({
    if (-not $script:ConnectionString) { return }

    # Stashed at script scope (not a plain local) so the OnComplete handler
    # below can read it reliably -- OnComplete actually runs later, from
    # Invoke-Async's Tick handler, by which point this click handler's own
    # local variables are gone. Same reasoning as $timer.Tag.OnComplete.
    # The Enabled=$false on $btnSearch during a run rules out a second
    # click clobbering this before OnComplete reads it.
    $script:LastSearchText = $txtSearch.Text
    $search = Resolve-SearchInput -Text $txtSearch.Text
    $range = Get-TimeRangeUtc -Preset $cmbRange.SelectedItem -CustomStartLocal $dtCustomStart.Value -CustomEndLocal $dtCustomEnd.Value

    $btnSearch.Enabled = $false
    $grid.DataSource = $null
    $txtQueryText.Text = ''
    $txtPlanXml.Text = ''
    Set-Status 'Running...'

    $connStr      = $script:ConnectionString
    $isQsOn       = $script:QueryStoreOn
    $rowCap       = $script:RowCap
    $timeoutSec   = $script:CommandTimeoutSec
    $qsSql        = $script:SqlQueryStore
    $pcSql        = $script:SqlPlanCache
    $tlSql        = $script:SqlQueryStoreTimeline

    Invoke-Async -Work {
        param($connStr,$isQsOn,$rowCap,$timeoutSec,$qsSql,$pcSql,$tlSql,$search,$range)

        Add-Type -AssemblyName System.Data

        # Self-contained copies of New-SqlParam / Invoke-HistoryQuery: this
        # scriptblock runs in its own isolated Runspace (via [powershell]::
        # Create()), so it cannot see functions defined in the main script's
        # scope -- only what's passed in via -ArgumentList.
        function local:New-SqlParamInner {
            param([string]$Name,[System.Data.SqlDbType]$Type,$Value,[int]$Size = 0)
            $p = New-Object System.Data.SqlClient.SqlParameter
            $p.ParameterName = $Name
            $p.SqlDbType = $Type
            if ($Size -gt 0) { $p.Size = $Size }
            $p.Value = if ($null -eq $Value) { [DBNull]::Value } else { $Value }
            return $p
        }
        function local:Invoke-HistoryQueryInner {
            param($ConnectionString,$CommandText,[System.Data.SqlClient.SqlParameter[]]$Parameters,$TimeoutSec)
            $conn = New-Object System.Data.SqlClient.SqlConnection $ConnectionString
            $cmd  = $conn.CreateCommand()
            $cmd.CommandText    = $CommandText
            $cmd.CommandTimeout = $TimeoutSec
            [void]$cmd.Parameters.AddRange($Parameters)
            $adapter = New-Object System.Data.SqlClient.SqlDataAdapter $cmd
            $dataSet = New-Object System.Data.DataSet
            try { $conn.Open(); [void]$adapter.Fill($dataSet) } finally { $conn.Close() }
            return $dataSet
        }

        if ($isQsOn) {
            $paramsQs = @(
                (New-SqlParamInner -Name '@QueryId'  -Type Int            -Value $search.QueryId)
                (New-SqlParamInner -Name '@ProcName' -Type NVarChar -Size 261 -Value $search.ProcName)
                (New-SqlParamInner -Name '@StartUtc' -Type DateTimeOffset -Value ([DateTimeOffset]$range.StartUtc))
                (New-SqlParamInner -Name '@EndUtc'   -Type DateTimeOffset -Value ([DateTimeOffset]$range.EndUtc))
                (New-SqlParamInner -Name '@RowCap'   -Type Int            -Value $rowCap)
            )
            $ds = Invoke-HistoryQueryInner -ConnectionString $connStr -CommandText $qsSql -Parameters $paramsQs -TimeoutSec $timeoutSec

            # Same filters, higher row cap (this is per plan-PER-INTERVAL,
            # not one row per plan, so it needs more headroom) -- feeds the
            # Timeline tab's scatter chart.
            $paramsTl = @(
                (New-SqlParamInner -Name '@QueryId'  -Type Int               -Value $search.QueryId)
                (New-SqlParamInner -Name '@ProcName' -Type NVarChar -Size 261 -Value $search.ProcName)
                (New-SqlParamInner -Name '@StartUtc' -Type DateTimeOffset    -Value ([DateTimeOffset]$range.StartUtc))
                (New-SqlParamInner -Name '@EndUtc'   -Type DateTimeOffset    -Value ([DateTimeOffset]$range.EndUtc))
                (New-SqlParamInner -Name '@RowCap'   -Type Int               -Value ([Math]::Max($rowCap, 2000)))
            )
            $dsTl = Invoke-HistoryQueryInner -ConnectionString $connStr -CommandText $tlSql -Parameters $paramsTl -TimeoutSec $timeoutSec

            return [pscustomobject]@{ Mode = 'QueryStore'; DataSet = $ds; TimelineDataSet = $dsTl }
        }
        else {
            $paramsPc = @(
                (New-SqlParamInner -Name '@ProcName'   -Type NVarChar  -Size 261 -Value $search.ProcName)
                (New-SqlParamInner -Name '@QueryHash'  -Type VarBinary -Size 8   -Value $search.QueryHash)
                (New-SqlParamInner -Name '@StartLocal' -Type DateTime2          -Value $range.StartUtc.ToLocalTime())
                (New-SqlParamInner -Name '@EndLocal'   -Type DateTime2          -Value $range.EndUtc.ToLocalTime())
                (New-SqlParamInner -Name '@RowCap'     -Type Int                -Value $rowCap)
            )
            $ds = Invoke-HistoryQueryInner -ConnectionString $connStr -CommandText $pcSql -Parameters $paramsPc -TimeoutSec $timeoutSec
            return [pscustomobject]@{ Mode = 'PlanCache'; DataSet = $ds }
        }
    } -ArgumentList @($connStr,$isQsOn,$rowCap,$timeoutSec,$qsSql,$pcSql,$tlSql,$search,$range) -OnComplete {
        param($result, $errText)

        $btnSearch.Enabled = $true

        if ($errText) {
            Set-Status 'Error.'
            [System.Windows.Forms.MessageBox]::Show($errText, 'Query failed', 'OK', 'Error') | Out-Null
            return
        }

        $payload = $result | Select-Object -Last 1
        if (-not $payload) { Set-Status 'No result.'; return }

        Add-SearchHistory -Text $script:LastSearchText

        if ($payload.Mode -eq 'QueryStore') {
            $table = $payload.DataSet.Tables[0]
            $grid.DataSource = $table
            Set-Status "Query Store mode -- $($table.Rows.Count) row(s)."
        }
        else {
            $combined = $payload.DataSet.Tables[0].Copy()
            if ($payload.DataSet.Tables.Count -gt 1) {
                foreach ($row in $payload.DataSet.Tables[1].Rows) {
                    [void]$combined.ImportRow($row)
                }
            }
            $grid.DataSource = $combined
            $table = $combined
            Set-Status "Plan cache mode -- $($combined.Rows.Count) row(s). Volatile view: evicted plans won't appear."
        }

        if ($grid.Columns.Contains('query_plan_xml'))    { $grid.Columns['query_plan_xml'].Visible = $false }
        if ($grid.Columns.Contains('plan_handle_hex'))   { $grid.Columns['plan_handle_hex'].Visible = $false }
        if ($grid.Columns.Contains('query_sql_text'))    { $grid.Columns['query_sql_text'].Width = 260 }

        $btnRemovePlan.Enabled = ($table.Rows.Count -gt 0)
        $btnRemovePlan.Text = if ($payload.Mode -eq 'QueryStore') { 'Remove Plan...' } else { 'Free Plan (DBCC)...' }
        $btnForcePlan.Enabled = ($payload.Mode -eq 'QueryStore' -and $table.Rows.Count -gt 0)
        $lblRemovePlanHint.Text = if ($payload.Mode -eq 'QueryStore') {
            'Remove/Force need db_owner.'
        } else {
            'DBCC FREEPROCCACHE needs ALTER SERVER STATE. Force Plan is Query Store only.'
        }

        $script:LastResultTable = $table
        if ($script:ChartAvailable) {
            Update-Chart -Table $table -Metric $cmbMetric.SelectedItem

            if ($payload.Mode -eq 'QueryStore' -and $payload.TimelineDataSet -and $payload.TimelineDataSet.Tables.Count -gt 0) {
                $script:LastTimelineTable = $payload.TimelineDataSet.Tables[0]
                Update-Timeline -Table $script:LastTimelineTable -Metric $cmbTlMetric.SelectedItem
            }
            else {
                # Plan cache mode: no time-series data exists to draw here.
                $script:LastTimelineTable = $null
                $chartTimeline.Series.Clear()
                $chartTimeline.Titles.Clear()
                [void]$chartTimeline.Titles.Add('Timeline needs Query Store to be ON -- plan cache has no history over time.')
            }
        }
    }
})

$btnRemovePlan.Add_Click({
    if (-not $script:LastResultTable -or $script:LastResultTable.Rows.Count -eq 0) { return }
    $table = $script:LastResultTable

    if ($script:QueryStoreOn) {
        # --- Query Store: sp_query_store_remove_plan, by plan_id ----------
        if (-not $table.Columns.Contains('plan_id')) { return }

        $items = @{}
        foreach ($row in $table.Rows) {
            $planId = $row['plan_id']
            if ($items.ContainsKey($planId)) { continue }
            $label = if (-not $row.IsNull('proc_name') -and $row['proc_name']) { [string]$row['proc_name'] } else { "Query $($row['query_id'])" }
            $dur   = if (-not $row.IsNull('avg_duration_ms')) { $row['avg_duration_ms'] } else { 0 }
            $execs = if (-not $row.IsNull('count_executions')) { $row['count_executions'] } else { 0 }
            $items[$planId] = "Plan $planId -- $label (avg $dur ms, $execs execs)"
        }
        $itemList = $items.Keys | Sort-Object | ForEach-Object { [pscustomobject]@{ Text = $items[$_]; Value = $_ } }

        $selectedPlanId =
            if (@($itemList).Count -eq 1) { $itemList[0].Value }
            else { Show-PickerDialog -Title 'Remove Plan' -Prompt "This query has $(@($itemList).Count) plans. Choose one to remove from Query Store:" -Items $itemList }
        if ($null -eq $selectedPlanId) { return }

        $confirm = [System.Windows.Forms.MessageBox]::Show(
            "Remove plan $selectedPlanId from Query Store?`r`n`r`nThis discards its captured plan and stats. The query will recompile on its next execution. This cannot be undone.",
            'Confirm Remove Plan', 'YesNo', 'Warning')
        if ($confirm -ne [System.Windows.Forms.DialogResult]::Yes) { return }

        try {
            $p = New-SqlParam -Name '@PlanId' -Type Int -Value $selectedPlanId
            Invoke-HistoryCommand -ConnectionString $script:ConnectionString -CommandText 'EXEC sys.sp_query_store_remove_plan @PlanId;' -Parameters @($p)
            Set-Status "Plan $selectedPlanId removed from Query Store."
            [System.Windows.Forms.MessageBox]::Show("Plan $selectedPlanId removed. Re-run Search to refresh the results.", 'Done', 'OK', 'Information') | Out-Null
        }
        catch {
            [System.Windows.Forms.MessageBox]::Show("Failed to remove plan $selectedPlanId`:`r`n$($_.Exception.Message)`r`n`r`nThis needs db_owner on the database.", 'Remove Plan failed', 'OK', 'Error') | Out-Null
        }
    }
    else {
        # --- No Query Store: DBCC FREEPROCCACHE(plan_handle) --------------
        if (-not $table.Columns.Contains('plan_handle_hex')) { return }

        $items = @{}
        foreach ($row in $table.Rows) {
            if ($row.IsNull('plan_handle_hex') -or -not $row['plan_handle_hex']) { continue }
            $handleHex = [string]$row['plan_handle_hex']
            if ($items.ContainsKey($handleHex)) { continue }
            $label = if (-not $row.IsNull('proc_name') -and $row['proc_name']) { [string]$row['proc_name'] }
                     elseif (-not $row.IsNull('query_hash_hex') -and $row['query_hash_hex']) { [string]$row['query_hash_hex'] }
                     else { '(unnamed)' }
            $dur = if (-not $row.IsNull('avg_duration_ms')) { $row['avg_duration_ms'] } else { 0 }
            $items[$handleHex] = "$label (avg $dur ms) -- $($handleHex.Substring(0, [Math]::Min(20,$handleHex.Length)))..."
        }
        if ($items.Count -eq 0) {
            [System.Windows.Forms.MessageBox]::Show('No plan handle available for these rows.', 'Nothing to remove', 'OK', 'Information') | Out-Null
            return
        }
        $itemList = $items.Keys | ForEach-Object { [pscustomobject]@{ Text = $items[$_]; Value = $_ } }

        $selectedHandleHex =
            if (@($itemList).Count -eq 1) { $itemList[0].Value }
            else { Show-PickerDialog -Title 'Free Plan' -Prompt "$(@($itemList).Count) distinct cached plans in these results. Choose one to evict:" -Items $itemList }
        if ($null -eq $selectedHandleHex) { return }

        $confirm = [System.Windows.Forms.MessageBox]::Show(
            "Run DBCC FREEPROCCACHE on this one plan?`r`n`r`n$selectedHandleHex`r`n`r`nThis evicts it from the plan cache; the next execution recompiles. This cannot be undone.",
            'Confirm Free Plan', 'YesNo', 'Warning')
        if ($confirm -ne [System.Windows.Forms.DialogResult]::Yes) { return }

        try {
            # Passed as a real varbinary parameter (not concatenated into the
            # DBCC text) even though it's our own hex, so this stays
            # consistent with how every other statement in this tool binds
            # values -- and DBCC FREEPROCCACHE happily takes a variable.
            # plan_handle_hex was produced by CONVERT(..., 1), which always
            # emits a "0x" prefix followed by uppercase hex digits.
            $hexDigits = $selectedHandleHex.Substring(2)
            $bytes = New-Object byte[] ($hexDigits.Length / 2)
            for ($i = 0; $i -lt $bytes.Length; $i++) { $bytes[$i] = [Convert]::ToByte($hexDigits.Substring($i * 2, 2), 16) }

            $p = New-SqlParam -Name '@PlanHandle' -Type VarBinary -Size 64 -Value $bytes
            Invoke-HistoryCommand -ConnectionString $script:ConnectionString -CommandText 'DECLARE @ph VARBINARY(64) = @PlanHandle; DBCC FREEPROCCACHE(@ph);' -Parameters @($p)
            Set-Status 'Plan freed from cache.'
            [System.Windows.Forms.MessageBox]::Show('Plan evicted from cache. Re-run Search to refresh the results.', 'Done', 'OK', 'Information') | Out-Null
        }
        catch {
            [System.Windows.Forms.MessageBox]::Show("Failed to free plan:`r`n$($_.Exception.Message)`r`n`r`nThis needs ALTER SERVER STATE permission.", 'Free Plan failed', 'OK', 'Error') | Out-Null
        }
    }
})

$btnForcePlan.Add_Click({
    if (-not $script:QueryStoreOn) { return }   # button is disabled in this mode, but guard anyway
    if (-not $script:LastResultTable -or $script:LastResultTable.Rows.Count -eq 0) { return }
    $table = $script:LastResultTable
    if (-not $table.Columns.Contains('plan_id') -or -not $table.Columns.Contains('query_id')) { return }

    $items = @{}
    foreach ($row in $table.Rows) {
        $key = "$($row['query_id'])|$($row['plan_id'])"
        if ($items.ContainsKey($key)) { continue }
        $label   = if (-not $row.IsNull('proc_name') -and $row['proc_name']) { [string]$row['proc_name'] } else { "Query $($row['query_id'])" }
        $dur     = if (-not $row.IsNull('avg_duration_ms')) { $row['avg_duration_ms'] } else { 0 }
        $isForced = -not $row.IsNull('is_forced_plan') -and $row['is_forced_plan']
        $tag = if ($isForced) { ' [CURRENTLY FORCED]' } else { '' }
        $items[$key] = [pscustomobject]@{
            Text     = "Query $($row['query_id']), Plan $($row['plan_id']) -- $label (avg $dur ms)$tag"
            QueryId  = $row['query_id']
            PlanId   = $row['plan_id']
            IsForced = [bool]$isForced
        }
    }
    $itemList = $items.Values | Sort-Object PlanId | ForEach-Object { [pscustomobject]@{ Text = $_.Text; Value = $_ } }

    $picked =
        if (@($itemList).Count -eq 1) { $itemList[0].Value }
        else { Show-PickerDialog -Title 'Force Plan' -Prompt "Choose a (query, plan) pair:" -Items $itemList }
    if ($null -eq $picked) { return }

    if ($picked.IsForced) {
        $confirm = [System.Windows.Forms.MessageBox]::Show(
            "Unforce plan $($picked.PlanId) for query $($picked.QueryId)?`r`n`r`nThe optimizer will go back to choosing its own plan for this query.",
            'Confirm Unforce Plan', 'YesNo', 'Warning')
        if ($confirm -ne [System.Windows.Forms.DialogResult]::Yes) { return }
        $sql = 'EXEC sys.sp_query_store_unforce_plan @query_id = @QueryId, @plan_id = @PlanId;'
        $verb = 'unforced'
    }
    else {
        $confirm = [System.Windows.Forms.MessageBox]::Show(
            "Force plan $($picked.PlanId) for query $($picked.QueryId)?`r`n`r`nThe optimizer will use this exact plan for every future execution of this query, until it's unforced or becomes invalid (e.g. after an index or schema change). Use Force Plan again on the same row to unforce it later.",
            'Confirm Force Plan', 'YesNo', 'Warning')
        if ($confirm -ne [System.Windows.Forms.DialogResult]::Yes) { return }
        $sql = 'EXEC sys.sp_query_store_force_plan @query_id = @QueryId, @plan_id = @PlanId;'
        $verb = 'forced'
    }

    try {
        $pQ = New-SqlParam -Name '@QueryId' -Type Int -Value $picked.QueryId
        $pP = New-SqlParam -Name '@PlanId'  -Type Int -Value $picked.PlanId
        Invoke-HistoryCommand -ConnectionString $script:ConnectionString -CommandText $sql -Parameters @($pQ, $pP)
        Set-Status "Plan $($picked.PlanId) $verb for query $($picked.QueryId)."
        [System.Windows.Forms.MessageBox]::Show("Plan $($picked.PlanId) $verb. Re-run Search to refresh the results.", 'Done', 'OK', 'Information') | Out-Null
    }
    catch {
        [System.Windows.Forms.MessageBox]::Show("Failed to $($verb -replace 'ed$','e') plan:`r`n$($_.Exception.Message)`r`n`r`nThis needs db_owner on the database.", 'Force/Unforce Plan failed', 'OK', 'Error') | Out-Null
    }
})

$grid.Add_SelectionChanged({
    if ($grid.CurrentRow -and $grid.CurrentRow.DataBoundItem) {
        $row = $grid.CurrentRow.DataBoundItem.Row
        $txtQueryText.Text = if ($row.Table.Columns.Contains('query_sql_text') -and -not $row.IsNull('query_sql_text')) { $row['query_sql_text'] } else { '' }
        $txtPlanXml.Text   = if ($row.Table.Columns.Contains('query_plan_xml') -and -not $row.IsNull('query_plan_xml')) { $row['query_plan_xml'] } else { '(no plan captured)' }
    }
})

$btnSavePlan.Add_Click({
    if ([string]::IsNullOrWhiteSpace($txtPlanXml.Text) -or $txtPlanXml.Text -eq '(no plan captured)') { return }
    $sfd = New-Object System.Windows.Forms.SaveFileDialog
    $sfd.Filter = 'SQL Plan (*.sqlplan)|*.sqlplan|All files (*.*)|*.*'
    $sfd.FileName = 'plan.sqlplan'
    if ($sfd.ShowDialog() -eq 'OK') {
        [System.IO.File]::WriteAllText($sfd.FileName, $txtPlanXml.Text)
    }
})

#endregion

# Populating a ComboBox's Items in bulk (AddRange) BEFORE its window
# handle exists -- which is what happens if this runs at top-level script
# scope, since that's all before ShowDialog() -- leaves the native
# Windows AutoComplete popup (AutoCompleteSource=ListItems) initialized
# against a stale snapshot. It then renders wrong (items smashed onto one
# row) the first time it pops up, even though the ComboBox's own
# click-the-arrow dropdown looks fine. Populating instead once here, in
# Shown (handle guaranteed to exist), matches how it already gets
# refreshed correctly during active use (Add-SearchHistory runs well
# after the form is visible) -- this is why the bug only showed up right
# after a fresh launch, never after searching a few times in the same run.
$form.Add_Shown({
    if ($script:SearchHistory.Count -gt 0) { [void]$txtSearch.Items.AddRange($script:SearchHistory) }
    if ($script:DatabaseCache -and $script:DatabaseCache.ContainsKey($txtServer.Text.Trim())) {
        [void]$txtDatabase.Items.AddRange(@($script:DatabaseCache[$txtServer.Text.Trim()]))
    }
})

[void]$form.ShowDialog()
