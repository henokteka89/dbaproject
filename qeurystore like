# Fire-and-poll async runner so the UI thread never blocks on the SQL call.
# Keeps the timer alive in $script:ActiveTimers until it fires.
$script:ActiveTimers = New-Object System.Collections.ArrayList

function Invoke-Async {
    param(
        [Parameter(Mandatory)] [scriptblock]$Work,
        [array]$ArgumentList = @(),
        [Parameter(Mandatory)] [scriptblock]$OnComplete
    )
    $runspace = [runspacefactory]::CreateRunspace()
    $runspace.Open()
    $ps = [powershell]::Create()
    $ps.Runspace = $runspace
    [void]$ps.AddScript($Work)
    foreach ($arg in $ArgumentList) { [void]$ps.AddArgument($arg) }
    $handle = $ps.BeginInvoke()

    $timer = New-Object System.Windows.Forms.Timer
    $timer.Interval = 150
    # OnComplete is stashed on $timer.Tag (not just closed over) on purpose:
    # $OnComplete is a local parameter of THIS function call, and this
    # function returns immediately after $timer.Start(). A plain scriptblock
    # referencing $OnComplete would find it gone by the time Tick fires
    # later -- that's the "expression after '&' ... not valid" / "It must
    # result in a command name, a script block" error. Reading it back off
    # $sender.Tag each tick sidesteps PowerShell scoping entirely.
    $timer.Tag = [pscustomobject]@{ PS = $ps; Runspace = $runspace; Handle = $handle; OnComplete = $OnComplete }
    $timer.Add_Tick({
        param($sender, $e)
        $state = $sender.Tag
        if ($state.Handle.IsCompleted) {
            $sender.Stop()
            [void]$script:ActiveTimers.Remove($sender)
            try {
                $result = $state.PS.EndInvoke($state.Handle)
                if ($state.PS.HadErrors) {
                    $errText = ($state.PS.Streams.Error | ForEach-Object { $_.ToString() }) -join "`r`n"
                    & $state.OnComplete $null $errText
                } else {
                    & $state.OnComplete $result $null
                }
            }
            catch {
                & $state.OnComplete $null $_.Exception.Message
            }
            finally {
                $state.PS.Dispose()
                $state.Runspace.Close()
            }
        }
    })
    [void]$script:ActiveTimers.Add($timer)
    $timer.Start()
}

