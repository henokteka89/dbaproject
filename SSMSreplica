#Requires -Version 5.1
#Requires -PSEdition Desktop
<#
.SYNOPSIS
    SQL Shortcut - a small SSMS-style query tool built with WinForms + PowerShell.

.DESCRIPTION
    - Enter a server name, click Connect, pick a database.
    - Type T-SQL or EXEC a stored procedure in the editor.
    - F5 / Run executes the SELECTED text, or the whole editor if nothing is selected (like SSMS).
    - GO batch separators are supported (including "GO 5").
    - Every result set gets its own grid tab; PRINT / errors go to the Messages tab.
    - Left pane = saved scripts library (stored as .sql files). Click to preview,
      double-click (or Load / Append) to copy into the editor.

    Run with:  powershell.exe -STA -ExecutionPolicy Bypass -File .\SqlShortcut.ps1
    Windows Authentication uses the identity of the PowerShell process. To use a different
    account, start it with:  runas /netonly /user:DOMAIN\account "powershell.exe -STA -File C:\path\SqlShortcut.ps1"
#>

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
Add-Type -AssemblyName Microsoft.VisualBasic
[System.Windows.Forms.Application]::EnableVisualStyles()

# Helper that receives PRINT/RAISERROR/error messages on any thread and hands them to the UI thread safely.
if (-not ('SqlMsgCollector' -as [type])) {
    Add-Type -ReferencedAssemblies 'System.Data' -TypeDefinition @'
using System;
using System.Collections.Generic;
using System.Data.SqlClient;

public class SqlMsgCollector
{
    private readonly Queue<string> _q = new Queue<string>();
    public int LineOffset = 0;
    public bool HadError = false;

    public SqlMsgCollector(SqlConnection conn)
    {
        conn.FireInfoMessageEventOnUserErrors = true;
        conn.InfoMessage += OnInfo;
    }

    private void OnInfo(object sender, SqlInfoMessageEventArgs e)
    {
        lock (_q)
        {
            foreach (SqlError err in e.Errors)
            {
                if (err.Class > 10)
                {
                    HadError = true;
                    string where = string.IsNullOrEmpty(err.Procedure)
                        ? "Line " + (err.LineNumber + LineOffset)
                        : "Procedure " + err.Procedure + ", Line " + err.LineNumber;
                    _q.Enqueue(string.Format("Msg {0}, Level {1}, State {2}, {3}\r\n{4}",
                        err.Number, err.Class, err.State, where, err.Message));
                }
                else
                {
                    _q.Enqueue(err.Message);
                }
            }
        }
    }

    public string[] Drain()
    {
        lock (_q)
        {
            string[] a = _q.ToArray();
            _q.Clear();
            return a;
        }
    }
}
'@
}

# ------------------------------------------------------------------ storage / settings
$script:Root         = Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'SqlShortcut'
$script:ScriptDir    = Join-Path $script:Root 'Scripts'
$script:SettingsFile = Join-Path $script:Root 'settings.json'
$script:AutoFile     = Join-Path $script:Root 'last_session.sql'
New-Item -ItemType Directory -Force -Path $script:ScriptDir | Out-Null

$script:Dirty           = $false
$script:Loading         = $false
$script:CurrentName     = $null
$script:Running         = $false
$script:CancelRequested = $false
$script:CurrentCmd      = $null
$script:SimpleTypes     = @([int16], [int32], [int64], [byte], [bool], [decimal], [double], [single],
                            [datetime], [datetimeoffset], [timespan], [guid], [string])

function Load-Settings {
    $s = [pscustomobject]@{
        Servers = @(); Auth = 'Windows Authentication'; User = ''; Trust = $true; Timeout = 300; MaxRows = 10000
    }
    try {
        if (Test-Path $script:SettingsFile) {
            $j = Get-Content -Path $script:SettingsFile -Raw | ConvertFrom-Json
            foreach ($p in @($s.PSObject.Properties.Name)) {
                if ($null -ne $j.$p) { $s.$p = $j.$p }
            }
        }
    } catch { }
    $s.Servers = @($s.Servers)
    return $s
}

function Save-Settings {
    try {
        $servers = @()
        foreach ($i in $cmbServer.Items) { $servers += [string]$i }
        [pscustomobject]@{
            Servers = $servers
            Auth    = $cmbAuth.Text
            User    = $txtUser.Text
            Trust   = $chkTrust.Checked
            Timeout = [int]$numTimeout.Value
            MaxRows = [int]$numMax.Value
        } | ConvertTo-Json | Set-Content -Path $script:SettingsFile -Encoding UTF8
    } catch { }
}

# ------------------------------------------------------------------ small helpers
function Get-NudValue($nud) {
    # NumericUpDown.Value only "commits" typed text when the control loses focus
    # (tab/click away) or the spinner arrows are used - if you type a new number
    # and immediately click Run, .Value can still be the old, stale number even
    # though the box visibly shows what you typed. Parse .Text directly instead
    # so Run always honors exactly what's on screen.
    $t = $nud.Text.Trim()
    $v = 0
    if ([decimal]::TryParse($t, [ref]$v)) {
        if ($v -lt $nud.Minimum) { $v = $nud.Minimum }
        if ($v -gt $nud.Maximum) { $v = $nud.Maximum }
        return [int]$v
    }
    return [int]$nud.Value
}

function Get-InnerMessage($ex) {
    while ($ex.InnerException) { $ex = $ex.InnerException }
    return $ex.Message
}

function Show-Info([string]$text) {
    [void][System.Windows.Forms.MessageBox]::Show($text, 'SQL Shortcut', 'OK', 'Information')
}

function Confirm-Action([string]$text) {
    $r = [System.Windows.Forms.MessageBox]::Show($text, 'SQL Shortcut', 'YesNo', 'Question')
    return ($r -eq [System.Windows.Forms.DialogResult]::Yes)
}

function Update-Title {
    $t = 'SQL Shortcut'
    if ($script:CurrentName) { $t += ' - ' + $script:CurrentName }
    if ($script:Dirty) { $t += ' *' }
    $form.Text = $t
}

function Add-Msg([string]$m) {
    $txtMsg.AppendText($m + "`r`n")
}

function Show-Msgs($collector) {
    if ($null -eq $collector) { return }
    foreach ($m in $collector.Drain()) { Add-Msg $m }
}

function Add-ConnPart([System.Text.StringBuilder]$sb, [string]$key, [string]$val) {
    if ($null -eq $val) { $val = '' }
    if ($val -match '[;={}\s]' -or $val.Contains("'") -or $val.Contains('"') -or $val.Length -eq 0) {
        if ($val.Contains("'") -and -not $val.Contains('"')) {
            $q = '"'; $safe = $val
        } else {
            $q = "'"; $safe = $val.Replace("'", "''")
        }
        [void]$sb.Append("$key=$q$safe$q;")
    } else {
        [void]$sb.Append("$key=$val;")
    }
}

# Built as a plain connection string (rather than SqlConnectionStringBuilder) to avoid
# environments where a mismatched/duplicate SqlClient assembly makes the builder reject
# valid keywords (seen as "Keyword not supported: 'DataSource'").
function New-ConnString([string]$db) {
    $sb = New-Object System.Text.StringBuilder
    Add-ConnPart $sb 'Data Source' $cmbServer.Text.Trim()
    if ($db) { Add-ConnPart $sb 'Initial Catalog' $db }
    if ($cmbAuth.SelectedIndex -eq 0) {
        [void]$sb.Append('Integrated Security=SSPI;')
    } else {
        Add-ConnPart $sb 'User ID' $txtUser.Text
        Add-ConnPart $sb 'Password' $txtPass.Text
    }
    [void]$sb.Append('Connect Timeout=15;')
    Add-ConnPart $sb 'Application Name' 'SQL Shortcut'
    if ($chkTrust.Checked) { [void]$sb.Append('TrustServerCertificate=True;') }
    return $sb.ToString()
}

# ------------------------------------------------------------------ connect / list databases
function Connect-Server {
    $srv = $cmbServer.Text.Trim()
    if (-not $srv) { Show-Info 'Enter a server name first.'; return }

    $prev = $cmbDb.Text
    $form.Cursor = [System.Windows.Forms.Cursors]::WaitCursor
    $lblRun.Text = 'Connecting...'
    [System.Windows.Forms.Application]::DoEvents()
    $conn = $null
    try {
        $conn = [System.Data.SqlClient.SqlConnection]::new((New-ConnString ''))
        $conn.Open()
        $cmd = $conn.CreateCommand()
        $cmd.CommandText = 'SELECT name FROM sys.databases WHERE HAS_DBACCESS(name) = 1 AND state = 0 ORDER BY name;'
        $rd = $cmd.ExecuteReader()
        $cmbDb.Items.Clear()
        while ($rd.Read()) { [void]$cmbDb.Items.Add($rd.GetString(0)) }
        $rd.Close()

        $idx = $cmbDb.Items.IndexOf($prev)
        if ($idx -lt 0) { $idx = $cmbDb.Items.IndexOf('master') }
        if ($idx -lt 0 -and $cmbDb.Items.Count -gt 0) { $idx = 0 }
        if ($idx -ge 0) { $cmbDb.SelectedIndex = $idx }

        # keep most recently used server at the top of the list
        $i = $cmbServer.Items.IndexOf($srv)
        if ($i -ge 0) { $cmbServer.Items.RemoveAt($i) }
        $cmbServer.Items.Insert(0, $srv)
        $cmbServer.Text = $srv

        $lblConn.Text = ('Connected: {0}  (v{1})' -f $srv, $conn.ServerVersion)
        Save-Settings
    } catch {
        $lblConn.Text = 'Not connected'
        [void][System.Windows.Forms.MessageBox]::Show((Get-InnerMessage $_.Exception), 'Connection failed', 'OK', 'Error')
    } finally {
        if ($conn) { $conn.Dispose() }
        $form.Cursor = [System.Windows.Forms.Cursors]::Default
        $lblRun.Text = 'Ready'
    }
}

# ------------------------------------------------------------------ query execution
function Split-Batches([string]$text) {
    $batches = New-Object System.Collections.ArrayList
    $lines = $text -split '\r?\n'
    $sb = New-Object System.Text.StringBuilder
    $start = 0
    for ($i = 0; $i -lt $lines.Length; $i++) {
        if ($lines[$i] -match '^\s*GO(?:\s+(\d+))?\s*(?:--.*)?$') {
            $cnt = 1
            if ($Matches[1]) { $cnt = [int]$Matches[1] }
            if ($sb.ToString().Trim().Length -gt 0) {
                [void]$batches.Add([pscustomobject]@{ Text = $sb.ToString(); Start = $start; Count = $cnt })
            }
            [void]$sb.Clear()
            $start = $i + 1
        } else {
            [void]$sb.AppendLine($lines[$i])
        }
    }
    if ($sb.ToString().Trim().Length -gt 0) {
        [void]$batches.Add([pscustomobject]@{ Text = $sb.ToString(); Start = $start; Count = 1 })
    }
    return , $batches
}

function Read-ResultSet($reader, [int]$max) {
    $dt = New-Object System.Data.DataTable
    $n = $reader.FieldCount
    $asText = @($false) * $n
    $used = @{}
    for ($i = 0; $i -lt $n; $i++) {
        $name = $reader.GetName($i)
        if ([string]::IsNullOrEmpty($name)) { $name = '(No column name)' }
        $base = $name
        $k = 1
        while ($used.ContainsKey($name)) { $k++; $name = '{0}_{1}' -f $base, $k }
        $used[$name] = $true
        $t = $null
        try { $t = $reader.GetFieldType($i) } catch { }
        if ($t -and ($script:SimpleTypes -contains $t)) {
            [void]$dt.Columns.Add($name, $t)
        } else {
            [void]$dt.Columns.Add($name, [string])
            $asText[$i] = $true
        }
    }

    $vals = New-Object object[] $n
    $count = 0
    $truncated = $false
    while ($reader.Read()) {
        if ($count -ge $max) {
            $truncated = $true
            $skipped = 0
            while ($reader.Read()) {
                $skipped++
                if (($skipped % 5000) -eq 0) {
                    [System.Windows.Forms.Application]::DoEvents()
                    if ($script:CancelRequested) { break }
                }
            }
            break
        }
        [void]$reader.GetValues($vals)
        $row = $dt.NewRow()
        for ($i = 0; $i -lt $n; $i++) {
            $v = $vals[$i]
            if ($v -is [System.DBNull]) { continue }
            if ($asText[$i]) {
                if ($v -is [byte[]]) { $v = '0x' + [System.BitConverter]::ToString($v).Replace('-', '') }
                else { $v = [string]$v }
            }
            $row[$i] = $v
        }
        $dt.Rows.Add($row)
        $count++
        if (($count % 2000) -eq 0) {
            [System.Windows.Forms.Application]::DoEvents()
            if ($script:CancelRequested) { break }
        }
    }
    # wrapped in an object so PowerShell does not unroll the DataTable into rows
    return [pscustomobject]@{ Table = $dt; Truncated = $truncated }
}

function Clear-Results {
    $txtMsg.Clear()
    for ($i = $tabs.TabPages.Count - 1; $i -ge 0; $i--) {
        $p = $tabs.TabPages[$i]
        if (-not [object]::ReferenceEquals($p, $tabMsg)) {
            $tabs.TabPages.RemoveAt($i)
            $p.Dispose()
        }
    }
}

function Add-ResultTab($dt, [int]$index) {
    $tab = New-Object System.Windows.Forms.TabPage
    $tab.Text = ('Results {0}  ({1} rows)' -f $index, $dt.Rows.Count)
    $tab.Tag = $dt

    $g = New-Object System.Windows.Forms.DataGridView
    $g.Dock = 'Fill'
    $g.ReadOnly = $true
    $g.AllowUserToAddRows = $false
    $g.AllowUserToDeleteRows = $false
    $g.AllowUserToOrderColumns = $true
    $g.ClipboardCopyMode = 'EnableWithAutoHeaderText'
    $g.AutoSizeColumnsMode = 'DisplayedCells'
    $g.RowHeadersWidth = 60
    $g.BackgroundColor = [System.Drawing.Color]::White
    $g.DefaultCellStyle.NullValue = 'NULL'
    $g.Add_DataBindingComplete({
        param($s, $e)
        try {
            foreach ($c in $s.Columns) {
                if ($c.Width -gt 450) { $c.AutoSizeMode = 'None'; $c.Width = 450 }
            }
        } catch { }
    })
    $g.Add_RowPostPaint({
        param($s, $e)
        try {
            $e.Graphics.DrawString(([string]($e.RowIndex + 1)), $s.Font,
                [System.Drawing.SystemBrushes]::ControlText, ($e.RowBounds.Left + 4), ($e.RowBounds.Top + 4))
        } catch { }
    })
    $g.DataSource = $dt
    $tab.Controls.Add($g)
    # results go in front of the Messages tab, which always stays last
    $tabs.TabPages.Insert($tabs.TabPages.Count - 1, $tab)
}

function Set-Running([bool]$on) {
    $btnRun.Enabled     = -not $on
    $btnCancel.Enabled  = $on
    $btnConnect.Enabled = -not $on
    $cmbServer.Enabled  = -not $on
    $cmbDb.Enabled      = -not $on
}

function Invoke-Query {
    if ($script:Running) { return }
    if ([string]::IsNullOrWhiteSpace($cmbServer.Text)) {
        Show-Info 'Enter a server name (and click Connect to load the databases) first.'
        return
    }

    $selText = $txtEditor.SelectedText
    if ($selText.Trim().Length -gt 0) {
        $sql = $selText
        $baseLine = $txtEditor.GetLineFromCharIndex($txtEditor.SelectionStart)
        $scope = 'selected text'
    } else {
        $sql = $txtEditor.Text
        $baseLine = 0
        $scope = 'entire editor'
    }
    if ($sql.Trim().Length -eq 0) { return }

    # commit whatever is currently typed in the numeric boxes, even if focus never left them
    $timeoutVal = Get-NudValue $numTimeout
    $maxRowsVal = Get-NudValue $numMax
    $numTimeout.Value = [decimal]$timeoutVal
    $numMax.Value = [decimal]$maxRowsVal

    Clear-Results
    $script:Running = $true
    $script:CancelRequested = $false
    Set-Running $true
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $conn = $null
    $collector = $null
    $reader = $null
    $resultCount = 0
    $hadError = $false
    $abort = $false

    try {
        $lblRun.Text = 'Connecting...'
        [System.Windows.Forms.Application]::DoEvents()
        $conn = [System.Data.SqlClient.SqlConnection]::new((New-ConnString $cmbDb.Text))
        $collector = New-Object SqlMsgCollector -ArgumentList $conn
        $conn.Open()

        # match SSMS default session option
        $c0 = $conn.CreateCommand()
        $c0.CommandText = 'SET ARITHABORT ON;'
        [void]$c0.ExecuteNonQuery()
        $c0.Dispose()

        Add-Msg ('Running {0} on {1} [{2}]' -f $scope, $cmbServer.Text.Trim(), $cmbDb.Text)
        Add-Msg ''

        $batches = Split-Batches $sql
        foreach ($b in $batches) {
            for ($rep = 0; $rep -lt $b.Count; $rep++) {
                if ($abort -or $script:CancelRequested) { break }

                $collector.LineOffset = $baseLine + $b.Start
                $cmd = $conn.CreateCommand()
                $cmd.CommandText = $b.Text
                # Enforced manually below via Cancel() - async CommandTimeout is unreliable
                # in the legacy System.Data.SqlClient provider, so don't depend on it.
                $cmd.CommandTimeout = 0
                $script:CurrentCmd = $cmd
                $timedOut = $false
                $cancelSent = $false
                try {
                    # async start + DoEvents loop keeps the window responsive and lets Cancel work
                    $swBatch = [System.Diagnostics.Stopwatch]::StartNew()
                    $ar = $cmd.BeginExecuteReader()
                    while (-not $ar.IsCompleted) {
                        [System.Windows.Forms.Application]::DoEvents()
                        Show-Msgs $collector
                        $lblRun.Text = 'Executing...  ' + $sw.Elapsed.ToString('hh\:mm\:ss')
                        if ((-not $cancelSent) -and $timeoutVal -gt 0 -and $swBatch.Elapsed.TotalSeconds -ge $timeoutVal) {
                            $timedOut = $true
                            $cancelSent = $true
                            try { $cmd.Cancel() } catch { }
                        }
                        Start-Sleep -Milliseconds 25
                    }
                    $reader = $cmd.EndExecuteReader($ar)
                    do {
                        if ($reader.FieldCount -gt 0) {
                            $lblRun.Text = 'Reading results...'
                            $res = Read-ResultSet $reader $maxRowsVal
                            $resultCount++
                            Add-ResultTab $res.Table $resultCount
                            Add-Msg ('({0} row(s) returned)' -f $res.Table.Rows.Count)
                            if ($res.Truncated) {
                                Add-Msg ('Display limited to the first {0} rows (change "Max rows" to see more).' -f $maxRowsVal)
                            }
                        }
                    } while ((-not $script:CancelRequested) -and $reader.NextResult())
                    $reader.Close()
                    if ($reader.RecordsAffected -ge 0) {
                        Add-Msg ('({0} row(s) affected)' -f $reader.RecordsAffected)
                    }
                } catch {
                    if ($timedOut) {
                        Add-Msg ("Query exceeded the configured timeout of {0}s and was cancelled." -f $timeoutVal)
                        $hadError = $true
                    } elseif ($script:CancelRequested) {
                        Add-Msg 'Query cancelled.'
                    } else {
                        Add-Msg ('Error: ' + (Get-InnerMessage $_.Exception))
                        $hadError = $true
                    }
                    $abort = $true
                } finally {
                    if ($reader) { try { $reader.Dispose() } catch { } ; $reader = $null }
                    $cmd.Dispose()
                    $script:CurrentCmd = $null
                }
                Show-Msgs $collector
                Add-Msg ''
            }
            if ($abort -or $script:CancelRequested) { break }
        }
        if ($script:CancelRequested -and -not $abort) { Add-Msg 'Query cancelled.' }
    } catch {
        Add-Msg ('Error: ' + (Get-InnerMessage $_.Exception))
        $hadError = $true
    } finally {
        Show-Msgs $collector
        if ($collector -and $collector.HadError) { $hadError = $true }
        if ($conn) { try { $conn.Close(); $conn.Dispose() } catch { } }
        $sw.Stop()
        Add-Msg ('Completed in ' + $sw.Elapsed.ToString('hh\:mm\:ss\.fff'))
        $script:Running = $false
        Set-Running $false
        $lblRun.Text = 'Done in ' + $sw.Elapsed.ToString('hh\:mm\:ss\.fff')
        if ($hadError -or $resultCount -eq 0) { $tabs.SelectedTab = $tabMsg }
        else { $tabs.SelectedIndex = 0 }
    }
}

function Export-CsvField($v) {
    if ($null -eq $v -or $v -is [System.DBNull]) { return '' }
    if ($v -is [datetime]) { $s = $v.ToString('yyyy-MM-dd HH:mm:ss.fff') } else { $s = [string]$v }
    if ($s -match '[",\r\n]') { $s = '"' + $s.Replace('"', '""') + '"' }
    return $s
}

function Export-TableCsv($dt, [string]$path) {
    $sb = New-Object System.Text.StringBuilder
    $cols = @($dt.Columns | ForEach-Object { $_.ColumnName })
    [void]$sb.AppendLine((@($cols | ForEach-Object { Export-CsvField $_ }) -join ','))
    foreach ($r in $dt.Rows) {
        $f = @(for ($i = 0; $i -lt $cols.Count; $i++) { Export-CsvField $r[$i] })
        [void]$sb.AppendLine(($f -join ','))
    }
    [System.IO.File]::WriteAllText($path, $sb.ToString(), (New-Object System.Text.UTF8Encoding($true)))
}

# ------------------------------------------------------------------ saved scripts
function Get-ScriptPath([string]$name) { return (Join-Path $script:ScriptDir ($name + '.sql')) }

function Read-ScriptFile([string]$name) {
    $path = Get-ScriptPath $name
    if (-not (Test-Path $path)) { return '' }
    $t = [System.IO.File]::ReadAllText($path)
    return ($t -replace "`r?`n", "`r`n")
}

function Refresh-ScriptList {
    $filter = $txtFilter.Text.Trim()
    $lstScripts.BeginUpdate()
    $lstScripts.Items.Clear()
    foreach ($f in (Get-ChildItem -Path $script:ScriptDir -Filter *.sql -File | Sort-Object Name)) {
        if (-not $filter -or $f.BaseName.IndexOf($filter, [StringComparison]::OrdinalIgnoreCase) -ge 0) {
            [void]$lstScripts.Items.Add($f.BaseName)
        }
    }
    $lstScripts.EndUpdate()
}

function Set-EditorText([string]$text) {
    $script:Loading = $true
    $txtEditor.Text = $text
    $txtEditor.SelectionStart = 0
    $txtEditor.SelectionLength = 0
    $script:Loading = $false
}

function Load-IntoEditor([string]$name, [bool]$append) {
    if (-not $name) { Show-Info 'Select a saved script first.'; return }
    $text = Read-ScriptFile $name
    if ($append) {
        if ($txtEditor.Text.Trim().Length -eq 0) { $txtEditor.Text = $text }
        else { $txtEditor.AppendText("`r`n`r`nGO`r`n`r`n" + $text) }
        return
    }
    if ($script:Dirty -and $txtEditor.Text.Trim().Length -gt 0) {
        if (-not (Confirm-Action 'The editor has unsaved changes. Replace them with the selected script?')) { return }
    }
    Set-EditorText $text
    $script:CurrentName = $name
    $script:Dirty = $false
    Update-Title
}

function New-Script {
    if ($script:Dirty -and $txtEditor.Text.Trim().Length -gt 0) {
        if (-not (Confirm-Action 'The editor has unsaved changes. Start a new script anyway?')) { return }
    }
    Set-EditorText ''
    $script:CurrentName = $null
    $script:Dirty = $false
    Update-Title
}

function Save-Current([bool]$asNew) {
    $text = $txtEditor.Text
    if ($text.Trim().Length -eq 0) { Show-Info 'The editor is empty.'; return }
    $name = $script:CurrentName
    if ($asNew -or -not $name) {
        $default = ''
        if ($name) { $default = $name }
        $name = [Microsoft.VisualBasic.Interaction]::InputBox('Script name:', 'Save script', $default)
        if ([string]::IsNullOrWhiteSpace($name)) { return }
        $name = $name.Trim()
        foreach ($c in [System.IO.Path]::GetInvalidFileNameChars()) { $name = $name.Replace([string]$c, '_') }
        if ((Test-Path (Get-ScriptPath $name)) -and ($name -ne $script:CurrentName)) {
            if (-not (Confirm-Action ("A script named '{0}' already exists. Overwrite it?" -f $name))) { return }
        }
    }
    [System.IO.File]::WriteAllText((Get-ScriptPath $name), $text, (New-Object System.Text.UTF8Encoding($true)))
    $script:CurrentName = $name
    $script:Dirty = $false
    Update-Title
    $txtFilter.Clear()
    Refresh-ScriptList
    $idx = $lstScripts.Items.IndexOf($name)
    if ($idx -ge 0) { $lstScripts.SelectedIndex = $idx }
    $lblRun.Text = "Saved '$name'"
}

function Remove-SavedScript {
    $name = [string]$lstScripts.SelectedItem
    if (-not $name) { Show-Info 'Select a saved script to delete.'; return }
    if (-not (Confirm-Action ("Delete saved script '{0}'?" -f $name))) { return }
    Remove-Item -Path (Get-ScriptPath $name) -Force -ErrorAction SilentlyContinue
    if ($script:CurrentName -eq $name) { $script:CurrentName = $null; Update-Title }
    $txtPreview.Clear()
    Refresh-ScriptList
}

# ------------------------------------------------------------------ build the UI
$settings = Load-Settings

$form = New-Object System.Windows.Forms.Form
$form.Text = 'SQL Shortcut'
$form.Size = New-Object System.Drawing.Size(1350, 850)
$form.StartPosition = 'CenterScreen'
$form.Font = New-Object System.Drawing.Font('Segoe UI', 9)
$form.KeyPreview = $true

function New-Label([string]$text) {
    $l = New-Object System.Windows.Forms.Label
    $l.Text = $text
    $l.AutoSize = $true
    $l.Margin = New-Object System.Windows.Forms.Padding(8, 7, 0, 0)
    return $l
}

# ---- top connection bar
$pnlTop = New-Object System.Windows.Forms.FlowLayoutPanel
$pnlTop.Dock = 'Top'
$pnlTop.AutoSize = $true
$pnlTop.AutoSizeMode = 'GrowAndShrink'
$pnlTop.WrapContents = $true
$pnlTop.Padding = New-Object System.Windows.Forms.Padding(4, 4, 4, 4)

$cmbServer = New-Object System.Windows.Forms.ComboBox
$cmbServer.Width = 230
$cmbServer.DropDownStyle = 'DropDown'
foreach ($s in $settings.Servers) { [void]$cmbServer.Items.Add([string]$s) }
if ($cmbServer.Items.Count -gt 0) { $cmbServer.Text = [string]$cmbServer.Items[0] }

$cmbAuth = New-Object System.Windows.Forms.ComboBox
$cmbAuth.DropDownStyle = 'DropDownList'
$cmbAuth.Width = 175
[void]$cmbAuth.Items.Add('Windows Authentication')
[void]$cmbAuth.Items.Add('SQL Server Authentication')
if ($settings.Auth -like 'SQL*') { $cmbAuth.SelectedIndex = 1 } else { $cmbAuth.SelectedIndex = 0 }

$txtUser = New-Object System.Windows.Forms.TextBox
$txtUser.Width = 110
$txtUser.Text = [string]$settings.User

$txtPass = New-Object System.Windows.Forms.TextBox
$txtPass.Width = 110
$txtPass.UseSystemPasswordChar = $true

$chkTrust = New-Object System.Windows.Forms.CheckBox
$chkTrust.Text = 'Trust server certificate'
$chkTrust.AutoSize = $true
$chkTrust.Margin = New-Object System.Windows.Forms.Padding(10, 6, 3, 3)
$chkTrust.Checked = [bool]$settings.Trust

$btnConnect = New-Object System.Windows.Forms.Button
$btnConnect.Text = 'Connect'
$btnConnect.Width = 85
$btnConnect.Height = 26

$cmbDb = New-Object System.Windows.Forms.ComboBox
$cmbDb.DropDownStyle = 'DropDownList'
$cmbDb.Width = 230

$numTimeout = New-Object System.Windows.Forms.NumericUpDown
$numTimeout.Minimum = 0
$numTimeout.Maximum = 86400
$numTimeout.Width = 70
$numTimeout.Value = [decimal][Math]::Min([Math]::Max([int]$settings.Timeout, 0), 86400)

$numMax = New-Object System.Windows.Forms.NumericUpDown
$numMax.Minimum = 1
$numMax.Maximum = 1000000
$numMax.Width = 85
$numMax.ThousandsSeparator = $true
$numMax.Value = [decimal][Math]::Min([Math]::Max([int]$settings.MaxRows, 1), 1000000)

$btnRun = New-Object System.Windows.Forms.Button
$btnRun.Text = 'Run (F5)'
$btnRun.Width = 90
$btnRun.Height = 26

$btnCancel = New-Object System.Windows.Forms.Button
$btnCancel.Text = 'Cancel'
$btnCancel.Width = 75
$btnCancel.Height = 26
$btnCancel.Enabled = $false

$btnExport = New-Object System.Windows.Forms.Button
$btnExport.Text = 'Export CSV'
$btnExport.Width = 90
$btnExport.Height = 26

foreach ($c in @(
    (New-Label 'Server:'), $cmbServer, (New-Label 'Login:'), $cmbAuth,
    (New-Label 'User:'), $txtUser, (New-Label 'Password:'), $txtPass, $chkTrust, $btnConnect,
    (New-Label 'Database:'), $cmbDb, (New-Label 'Timeout (s, 0 = none):'), $numTimeout,
    (New-Label 'Max rows:'), $numMax, $btnRun, $btnCancel, $btnExport)) {
    $pnlTop.Controls.Add($c)
}
$pnlTop.SetFlowBreak($btnConnect, $true)

$tip = New-Object System.Windows.Forms.ToolTip
$tip.SetToolTip($btnRun, 'Runs the selected text, or the whole editor if nothing is selected (F5 / Ctrl+E)')
$tip.SetToolTip($btnExport, 'Export the currently selected results tab to CSV')

# ---- status bar
$statusStrip = New-Object System.Windows.Forms.StatusStrip
$lblConn = New-Object System.Windows.Forms.ToolStripStatusLabel
$lblConn.Text = 'Not connected'
$lblRun = New-Object System.Windows.Forms.ToolStripStatusLabel
$lblRun.Text = 'Ready'
$lblRun.Spring = $true
$lblRun.TextAlign = 'MiddleRight'
[void]$statusStrip.Items.Add($lblConn)
[void]$statusStrip.Items.Add($lblRun)

# ---- main splitters: [saved scripts | editor over results]
$splitMain = New-Object System.Windows.Forms.SplitContainer
$splitMain.Dock = 'Fill'
$splitMain.Orientation = 'Vertical'
$splitMain.FixedPanel = 'Panel1'

$splitLeft = New-Object System.Windows.Forms.SplitContainer
$splitLeft.Dock = 'Fill'
$splitLeft.Orientation = 'Horizontal'
$splitMain.Panel1.Controls.Add($splitLeft)

$splitRight = New-Object System.Windows.Forms.SplitContainer
$splitRight.Dock = 'Fill'
$splitRight.Orientation = 'Horizontal'
$splitMain.Panel2.Controls.Add($splitRight)

# ---- left: saved scripts list + buttons
$lstScripts = New-Object System.Windows.Forms.ListBox
$lstScripts.Dock = 'Fill'
$lstScripts.IntegralHeight = $false

$txtFilter = New-Object System.Windows.Forms.TextBox
$txtFilter.Dock = 'Top'

$lblSaved = New-Object System.Windows.Forms.Label
$lblSaved.Text = 'Saved scripts (type below to filter)'
$lblSaved.Dock = 'Top'
$lblSaved.Height = 20
$lblSaved.TextAlign = 'MiddleLeft'

$flowBtns = New-Object System.Windows.Forms.FlowLayoutPanel
$flowBtns.Dock = 'Bottom'
$flowBtns.AutoSize = $true
$flowBtns.AutoSizeMode = 'GrowAndShrink'

$btnNew    = New-Object System.Windows.Forms.Button; $btnNew.Text = 'New'
$btnSave   = New-Object System.Windows.Forms.Button; $btnSave.Text = 'Save'
$btnSaveAs = New-Object System.Windows.Forms.Button; $btnSaveAs.Text = 'Save As'
$btnLoad   = New-Object System.Windows.Forms.Button; $btnLoad.Text = 'Load'
$btnAppend = New-Object System.Windows.Forms.Button; $btnAppend.Text = 'Append'
$btnDelete = New-Object System.Windows.Forms.Button; $btnDelete.Text = 'Delete'
foreach ($b in @($btnNew, $btnSave, $btnSaveAs, $btnLoad, $btnAppend, $btnDelete)) {
    $b.Width = 62
    $b.Height = 26
    $flowBtns.Controls.Add($b)
}
$tip.SetToolTip($btnLoad, 'Replace the editor contents with the selected saved script')
$tip.SetToolTip($btnAppend, 'Add the selected saved script to the end of the editor')

# Fill first, then Top/Bottom docks (last added is docked outermost)
$splitLeft.Panel1.Controls.Add($lstScripts)
$splitLeft.Panel1.Controls.Add($flowBtns)
$splitLeft.Panel1.Controls.Add($txtFilter)
$splitLeft.Panel1.Controls.Add($lblSaved)

$txtPreview = New-Object System.Windows.Forms.TextBox
$txtPreview.Multiline = $true
$txtPreview.ReadOnly = $true
$txtPreview.ScrollBars = 'Both'
$txtPreview.WordWrap = $false
$txtPreview.Dock = 'Fill'
$txtPreview.Font = New-Object System.Drawing.Font('Consolas', 9)
$txtPreview.BackColor = [System.Drawing.Color]::WhiteSmoke

$lblPreview = New-Object System.Windows.Forms.Label
$lblPreview.Text = 'Preview (double-click a script to load it into the editor)'
$lblPreview.Dock = 'Top'
$lblPreview.Height = 20
$lblPreview.TextAlign = 'MiddleLeft'

$splitLeft.Panel2.Controls.Add($txtPreview)
$splitLeft.Panel2.Controls.Add($lblPreview)

# ---- right top: editor
$txtEditor = New-Object System.Windows.Forms.TextBox
$txtEditor.Multiline = $true
$txtEditor.Dock = 'Fill'
$txtEditor.ScrollBars = 'Both'
$txtEditor.WordWrap = $false
$txtEditor.AcceptsTab = $true
$txtEditor.AcceptsReturn = $true
$txtEditor.HideSelection = $false
$txtEditor.MaxLength = [int]::MaxValue
$txtEditor.Font = New-Object System.Drawing.Font('Consolas', 10.5)
$splitRight.Panel1.Controls.Add($txtEditor)

# ---- right bottom: results tabs + messages
$tabs = New-Object System.Windows.Forms.TabControl
$tabs.Dock = 'Fill'

$tabMsg = New-Object System.Windows.Forms.TabPage
$tabMsg.Text = 'Messages'
$txtMsg = New-Object System.Windows.Forms.TextBox
$txtMsg.Multiline = $true
$txtMsg.ReadOnly = $true
$txtMsg.Dock = 'Fill'
$txtMsg.ScrollBars = 'Both'
$txtMsg.WordWrap = $false
$txtMsg.BackColor = [System.Drawing.Color]::White
$txtMsg.Font = New-Object System.Drawing.Font('Consolas', 9.5)
$tabMsg.Controls.Add($txtMsg)
$tabs.TabPages.Add($tabMsg)
$splitRight.Panel2.Controls.Add($tabs)

# Fill control first, then Top, then Bottom
$form.Controls.Add($splitMain)
$form.Controls.Add($pnlTop)
$form.Controls.Add($statusStrip)

# ------------------------------------------------------------------ events
$cmbAuth.Add_SelectedIndexChanged({
    $isSql = ($cmbAuth.SelectedIndex -eq 1)
    $txtUser.Enabled = $isSql
    $txtPass.Enabled = $isSql
})
$txtUser.Enabled = ($cmbAuth.SelectedIndex -eq 1)
$txtPass.Enabled = ($cmbAuth.SelectedIndex -eq 1)

$btnConnect.Add_Click({ Connect-Server })
$cmbServer.Add_KeyDown({
    param($s, $e)
    if ($e.KeyCode -eq 'Enter') { $e.SuppressKeyPress = $true; Connect-Server }
})

$btnRun.Add_Click({ Invoke-Query })
$btnCancel.Add_Click({
    $script:CancelRequested = $true
    try { if ($script:CurrentCmd) { $script:CurrentCmd.Cancel() } } catch { }
    $lblRun.Text = 'Cancelling...'
})

$btnExport.Add_Click({
    $tab = $tabs.SelectedTab
    if ($tab -and ($tab.Tag -is [System.Data.DataTable])) {
        $dlg = New-Object System.Windows.Forms.SaveFileDialog
        $dlg.Filter = 'CSV file (*.csv)|*.csv'
        $dlg.FileName = 'results.csv'
        if ($dlg.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
            try {
                Export-TableCsv $tab.Tag $dlg.FileName
                $lblRun.Text = 'Exported ' + $dlg.FileName
            } catch {
                [void][System.Windows.Forms.MessageBox]::Show((Get-InnerMessage $_.Exception), 'Export failed', 'OK', 'Error')
            }
        }
    } else {
        Show-Info 'Select a results tab first.'
    }
})

$txtEditor.Add_TextChanged({
    if (-not $script:Loading -and -not $script:Dirty) {
        $script:Dirty = $true
        Update-Title
    }
})

$txtFilter.Add_TextChanged({ Refresh-ScriptList })
$lstScripts.Add_SelectedIndexChanged({
    if ($lstScripts.SelectedItem) { $txtPreview.Text = Read-ScriptFile ([string]$lstScripts.SelectedItem) }
    else { $txtPreview.Clear() }
})
$lstScripts.Add_DoubleClick({
    if ($lstScripts.SelectedItem) { Load-IntoEditor ([string]$lstScripts.SelectedItem) $false }
})

$btnNew.Add_Click({ New-Script })
$btnSave.Add_Click({ Save-Current $false })
$btnSaveAs.Add_Click({ Save-Current $true })
$btnLoad.Add_Click({ Load-IntoEditor ([string]$lstScripts.SelectedItem) $false })
$btnAppend.Add_Click({ Load-IntoEditor ([string]$lstScripts.SelectedItem) $true })
$btnDelete.Add_Click({ Remove-SavedScript })

$form.Add_KeyDown({
    param($s, $e)
    if (($e.KeyCode -eq 'F5') -or ($e.Control -and ($e.KeyCode -eq 'E'))) {
        $e.SuppressKeyPress = $true
        Invoke-Query
    } elseif ($e.Control -and ($e.KeyCode -eq 'S')) {
        $e.SuppressKeyPress = $true
        Save-Current $false
    } elseif ($e.Control -and ($e.KeyCode -eq 'A') -and $txtEditor.Focused) {
        $e.SuppressKeyPress = $true
        $txtEditor.SelectAll()
    }
})

$form.Add_Shown({
    try { $splitMain.SplitterDistance = 300 } catch { }
    try { $splitLeft.SplitterDistance = [int]($splitLeft.Height * 0.55) } catch { }
    try { $splitRight.SplitterDistance = [int]($splitRight.Height * 0.42) } catch { }
    Refresh-ScriptList

    # restore whatever was in the editor last time
    $restored = $false
    try {
        if (Test-Path $script:AutoFile) {
            $t = [System.IO.File]::ReadAllText($script:AutoFile)
            if ($t.Trim().Length -gt 0) { Set-EditorText ($t -replace "`r?`n", "`r`n"); $restored = $true }
        }
    } catch { }
    if (-not $restored) {
        Set-EditorText ("-- Type T-SQL or EXEC a proc here. Select part of the text and press F5 to run only that part.`r`n" +
                        "SELECT @@SERVERNAME AS ServerName, DB_NAME() AS CurrentDb, SUSER_SNAME() AS LoginName;")
    }
    $script:Dirty = $false
    Update-Title
    if ([string]::IsNullOrWhiteSpace($cmbServer.Text)) { $cmbServer.Focus() } else { $txtEditor.Focus() }
})

$form.Add_FormClosing({
    param($s, $e)
    if ($script:Running) {
        Show-Info 'A query is still running. Cancel it first.'
        $e.Cancel = $true
        return
    }
    try { [System.IO.File]::WriteAllText($script:AutoFile, $txtEditor.Text, (New-Object System.Text.UTF8Encoding($true))) } catch { }
    Save-Settings
})

[void]$form.ShowDialog()
$form.Dispose()
